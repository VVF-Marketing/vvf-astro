---
// Resources (spec 7.12): every article, newest first.
import PageLayout from '../../layouts/PageLayout.astro'
import ResourceList from '../../components/ResourceList.astro'
import { getResources, getPageCopy } from '../../lib/content'
import { localeFromPath, pageAlternates } from '../../lib/i18n'
import { withPage } from '../../lib/pagination'
import pageCopy from './_copy'

const locale = localeFromPath(Astro.originPathname)

const all = await getResources(undefined, locale)
const { copy, locales } = await getPageCopy(pageCopy, locale)
---

<PageLayout
  title={copy['seo.title']}
  description={copy['seo.description']}
  image={copy['seo.image']}
  alternates={withPage(pageAlternates(pageCopy.route, locales), Astro.url.searchParams.get('page'))}
>
  <ResourceList resources={all} />
</PageLayout>
