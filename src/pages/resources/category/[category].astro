---
// Resources by category — live /resources-categories/<category>.
import PageLayout from '../../../layouts/PageLayout.astro'
import ResourceList from '../../../components/ResourceList.astro'
import { getResources, getPageCopy } from '../../../lib/content'
import { localeFromPath, pageAlternates } from '../../../lib/i18n'
import { RESOURCE_CATEGORIES, type ResourceCategory } from '../../../lib/content/types'
import categoryCopy from './_copy'

const locale = localeFromPath(Astro.originPathname)

const category = Astro.params.category as ResourceCategory
if (!RESOURCE_CATEGORIES.includes(category)) return new Response('Not found', { status: 404 })
const pageCopy = categoryCopy.find((m) => m.route === `/resources/category/${category}`)!
const { copy, locales } = await getPageCopy(pageCopy, locale)
const all = await getResources(undefined, locale)
const resources = all.filter((r) => r.categories.includes(category))
---

<PageLayout
  title={copy['seo.title']}
  description={copy['seo.description']}
  image={copy['seo.image']}
  alternates={pageAlternates(pageCopy.route, locales)}
>
  <ResourceList resources={resources} all={all} category={category} />
</PageLayout>
