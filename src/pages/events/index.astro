---
// Events & Campaigns — mirrors the live /all-events page (scripts/migrate/snapshot/pages/all-events.json).
import PageLayout from '../../layouts/PageLayout.astro'
import Hero from '../../components/Hero.astro'
import Eyebrow from '../../components/Eyebrow.astro'
import SectionTitle from '../../components/SectionTitle.astro'
import EventCard from '../../components/EventCard.astro'
import NewsletterSignup from '../../components/NewsletterSignup.astro'
import { getEvents, isUpcoming, getPageCopy } from '../../lib/content'
import { localeFromPath, pageAlternates } from '../../lib/i18n'
import pageCopy from './_copy'

const locale = localeFromPath(Astro.originPathname)

const events = await getEvents(locale)
const upcoming = events.filter(isUpcoming).sort((a, b) => a.startDate.localeCompare(b.startDate))
const past = events.filter((e) => !isUpcoming(e)).sort((a, b) => b.startDate.localeCompare(a.startDate))
const { copy, locales } = await getPageCopy(pageCopy, locale)
---

<PageLayout
  title={copy['seo.title']}
  description={copy['seo.description']}
  image={copy['seo.image']}
  alternates={pageAlternates(pageCopy.route, locales)}
>
  <Hero
    align="right"
    imageUrl="/images/pages/ec68af0e-98.png"
    imageAlt={copy['hero.imageAlt']}
    heading={copy['hero.heading']}
    subtext={copy['hero.subtext']}
    primaryCta={{ label: copy['hero.label.1'], href: '#upcoming-events' }}
  />

  {
    upcoming.length > 0 && (
      <section id="upcoming-events" class="scroll-mt-8 px-6 md:px-20">
        <div class="mx-auto flex max-w-screen-xl flex-col items-center gap-10">
          <Eyebrow>{copy['eyebrow.text']}</Eyebrow>
          <div class="flex w-full flex-col gap-6">
            {upcoming.map((e) => (
              <EventCard event={e} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    past.length > 0 && (
      <section class="px-6 pt-16 md:pt-[72px] md:px-20">
        <SectionTitle tagline={copy['sectionTitle.tagline']} heading={copy['sectionTitle.heading']} text={copy['sectionTitle.text']} />
        <div class="mx-auto mt-16 grid max-w-screen-xl gap-6 lg:grid-cols-2">
          {past.map((e) => (
            <EventCard event={e} variant="compact" ctaLabel={copy['eventCard2.ctaLabel']} />
          ))}
        </div>
      </section>
    )
  }

  <section class="px-6 pb-16 md:pb-[120px] pt-16 md:pt-[240px] md:px-20">
    <div class="mx-auto max-w-screen-xl">
      <NewsletterSignup heading={copy['newsletterSignup.heading']} text={copy['newsletterSignup.text']} width="wide" />
    </div>
  </section>
</PageLayout>
