---
// Events & Campaigns — mirrors the live /all-events page (scripts/migrate/snapshot/pages/all-events.json).
import PageLayout from '../../layouts/PageLayout.astro'
import Hero from '../../components/Hero.astro'
import Eyebrow from '../../components/Eyebrow.astro'
import SectionTitle from '../../components/SectionTitle.astro'
import EventCard from '../../components/EventCard.astro'
import NewsletterSignup from '../../components/NewsletterSignup.astro'
import { getEvents, isUpcoming } from '../../lib/content'

const events = await getEvents()
const upcoming = events.filter(isUpcoming).sort((a, b) => a.startDate.localeCompare(b.startDate))
const past = events.filter((e) => !isUpcoming(e)).sort((a, b) => b.startDate.localeCompare(a.startDate))
---

<PageLayout
  title="Events & Campaigns | Victoria Venezuela Foundation"
  description="Join Victoria Venezuela Foundation events and campaigns, including our annual charity golf tournament, supporting children in Venezuela."
>
  <Hero
    align="right"
    imageUrl="/images/pages/ec68af0e-98.png"
    imageAlt="A golfer hugging a young boy on the course at the charity golf tournament."
    heading="Events & Campaigns"
    subtext="Join our community and make an impact. Together we gather to support those in need across Venezuela."
    primaryCta={{ label: 'Upcoming Events', href: '#upcoming-events' }}
  />

  {
    upcoming.length > 0 && (
      <section id="upcoming-events" class="scroll-mt-8 px-6 md:px-20">
        <div class="mx-auto flex max-w-screen-xl flex-col items-center gap-10">
          <Eyebrow>Upcoming</Eyebrow>
          <div class="flex w-full flex-col gap-6">
            {upcoming.map((e) => (
              <EventCard event={e} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    past.length > 0 && (
      <section class="px-6 pt-16 md:pt-[72px] md:px-20">
        <SectionTitle tagline="Archive" heading="Past" text="Gatherings that changed lives and raised hope" />
        <div class="mx-auto mt-16 grid max-w-screen-xl gap-6 lg:grid-cols-2">
          {past.map((e) => (
            <EventCard event={e} variant="compact" ctaLabel="See the recap" />
          ))}
        </div>
      </section>
    )
  }

  <section class="px-6 pb-16 md:pb-[120px] pt-16 md:pt-[240px] md:px-20">
    <div class="mx-auto max-w-screen-xl">
      <NewsletterSignup heading="Never miss an event" text="Get invitations and updates delivered to your inbox" width="wide" />
    </div>
  </section>
</PageLayout>
