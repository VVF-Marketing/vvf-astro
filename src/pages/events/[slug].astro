---
// Event detail — mirrors the live /events/<slug> template. Upcoming events
// get the full ticketing layout; past events get the recap layout.
import PageLayout from '../../layouts/PageLayout.astro'
import Hero from '../../components/Hero.astro'
import WhatWhenWhere from '../../components/WhatWhenWhere.astro'
import LogoCarousel from '../../components/LogoCarousel.astro'
import AppealPanel from '../../components/AppealPanel.astro'
import PhotoMosaic from '../../components/PhotoMosaic.astro'
import ProgramTimeline from '../../components/ProgramTimeline.astro'
import IncludesPanel from '../../components/IncludesPanel.astro'
import SectionTitle from '../../components/SectionTitle.astro'
import TicketCard from '../../components/TicketCard.astro'
import BenefitsTable from '../../components/BenefitsTable.astro'
import SpecialOpportunities from '../../components/SpecialOpportunities.astro'
import ImpactPanel from '../../components/ImpactPanel.astro'
import FaqAccordion from '../../components/FaqAccordion.astro'
import ContactCta from '../../components/ContactCta.astro'
import NewsletterSignup from '../../components/NewsletterSignup.astro'
import StatTileRow from '../../components/StatTileRow.astro'
import GalleryCarousel from '../../components/GalleryCarousel.astro'
import ProgramsCta from '../../components/ProgramsCta.astro'
import PastelCard from '../../components/PastelCard.astro'
import Button from '../../components/Button.astro'
import { getEventBySlug, getEvents, getFaqs, isUpcoming, getPageCopy } from '../../lib/content'
import { alternatePaths, LANG_TAGS, localeFromPath } from '../../lib/i18n'
import { fill } from '../../lib/globalCopy'
import { eventTicketUrl } from '../../lib/donorbox'
import { listItemTexts, listItemsWithLead } from '../../lib/portableText'
import templateCopy from './_copy.detail'

const locale = localeFromPath(Astro.originPathname)
const { copy } = await getPageCopy(templateCopy, locale)

const event = await getEventBySlug(Astro.params.slug!, locale)
if (!event) return new Response('Not found', { status: 404 })

const upcoming = isUpcoming(event)
const ticketUrl = event.donorboxEventId ? `${eventTicketUrl(event.donorboxEventId)}/steps/choose_tickets` : '/contact'
const offers = [...(event.sponsorPackages ?? [])].sort((a, b) => (a.order ?? 0) - (b.order ?? 0))
const tickets = offers.filter((o) => o.kind === 'ticket')
const packages = offers.filter((o) => o.kind === 'package')
const specials = offers.filter((o) => o.kind === 'special')
const faqs = upcoming ? await getFaqs('tournament', locale) : []
const date = new Date(event.startDate)
const monthDay = date.toLocaleDateString(LANG_TAGS[locale], { month: 'long', day: 'numeric', timeZone: 'UTC' })
const longDate = date.toLocaleDateString(LANG_TAGS[locale], { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
const nextEvent = upcoming
  ? undefined
  : (await getEvents(locale)).filter(isUpcoming).sort((a, b) => a.startDate.localeCompare(b.startDate))[0]
const ticketTones = ['sun', 'sky', 'salmon'] as const
---

<PageLayout
  title={event.seo?.title ?? fill(copy['seo.titleFallback'], { title: event.title })}
  description={event.seo?.description ?? event.description}
  image={event.seo?.imageUrl ?? event.heroImageUrl ?? event.imageUrl}
  background="section"
  alternates={alternatePaths('/events', event.alternates)}
  contentLocale={event.fallbackLocale}
>
  <Hero
    imageUrl={event.heroImageUrl ?? event.imageUrl}
    mobileImageUrl={event.heroImageMobileUrl}
    heading={event.heroHeading ?? event.title}
    subtext={event.heroBody}
    primaryCta={upcoming ? { label: copy['hero.label.1'], href: ticketUrl } : { label: copy['hero.label.2'], href: '#photos' }}
    secondaryCta={upcoming ? { label: copy['hero.label.3'], href: '#sponsor-packages' } : { label: copy['hero.label.4'], href: '#next-edition' }}
    flush
  />

  {
    upcoming ? (
      <>
        <WhatWhenWhere title={event.title} dateText={date.toLocaleDateString(LANG_TAGS[locale], { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })} venue={event.venue} address={event.address} mapUrl={event.mapUrl} />

        {event.sponsors && event.sponsors.length > 0 && (
          <section class="bg-neutral-white"><LogoCarousel heading={copy['logoCarousel.heading']} logos={event.sponsors} /></section>
        )}

        {event.appeal && (
          <div class="pt-16 md:pt-[80px]">
            <AppealPanel
              heading={event.appeal.heading}
              text={event.appeal.text}
              imageUrl={event.appeal.imageUrl}
              imageAlt={event.appeal.imageAlt}
              caption={event.appeal.caption}
              cardsLabel={event.appeal.cardsLabel}
              cards={event.appeal.cards}
              secondaryCta={event.appeal.cta}
            />
          </div>
        )}

        {event.gallery && event.gallery.length > 0 && <PhotoMosaic heading={fill(copy['memories.heading'], { year: date.getUTCFullYear() - 1 })} photos={event.gallery} />}

        {event.program && event.program.length > 0 && (
          <ProgramTimeline meta={[longDate, event.venue, event.address].filter(Boolean) as string[]} items={listItemsWithLead(event.program)} />
        )}

        {event.includes && event.includes.length > 0 && (
          <div class="pt-16 md:pt-[120px]"><IncludesPanel heading={copy['includesPanel.heading']} items={listItemTexts(event.includes)} /></div>
        )}

        {tickets.length > 0 && (
          <section id="tickets" class="px-6 pt-16 md:pt-[120px] md:px-[134px]">
            <SectionTitle heading={copy['sectionTitle.heading']} />
            <div class="mx-auto mt-16 grid max-w-[1172px] justify-items-center gap-x-[68px] gap-y-6 md:grid-cols-2">
              {tickets.map((t, i) => (
                <TicketCard tierName={t.tierName} price={t.price} features={t.benefits} href={t.ctaUrl ?? ticketUrl} ctaLabel={t.ctaLabel} soldOut={t.soldOut} tone={ticketTones[i % 3]} />
              ))}
            </div>
          </section>
        )}

        {packages.length > 0 && event.benefitRows && event.benefitRows.length > 0 && (
          <section id="sponsor-packages" class="scroll-mt-8 px-6 pt-16 md:pt-[120px] md:px-16">
            <SectionTitle heading={copy['sectionTitle2.heading']} />
            <div class="mx-auto mt-16 max-w-[1312px]"><BenefitsTable packages={packages} rows={event.benefitRows} /></div>
          </section>
        )}

        {specials.length > 0 && <SpecialOpportunities offers={specials} />}

        <ImpactPanel
          imageUrl="/images/pages/a3fef8e5-9f807887-6eeb-46a6-8c18-3fd6f3f03c8e-1.png"
          imageAlt={copy['impactPanel.imageAlt']}
          stats={[
            { value: copy['impactPanel.value.1'], label: copy['impactPanel.label.1'] },
            { value: copy['impactPanel.value.2'], label: copy['impactPanel.label.2'] },
            { value: copy['impactPanel.value.3'], label: copy['impactPanel.label.3'] },
          ]}
        />

        {faqs.length > 0 && (
          <section class="px-6 pt-16 md:pt-[120px]">
            <SectionTitle heading={copy['sectionTitle3.heading']} />
            <div class="mt-12"><FaqAccordion faqs={faqs} /></div>
          </section>
        )}

        <div class="pt-16 md:pt-[120px]">
          <ContactCta
            phone={event.contact?.phone}
            email={event.contact?.email}
            address={event.contact?.address}
            heading={fill(copy['contact.heading'], { date: monthDay })}
            cta={{ label: copy['contactCta.label.1'], href: ticketUrl }}
          />
        </div>
      </>
    ) : (
      <>
        {event.recapStats && event.recapStats.length > 0 && (
          <section class="px-6 pt-16 md:pt-[120px] md:px-20">
            <div class="mx-auto flex max-w-screen-xl flex-col gap-12 lg:flex-row lg:items-start lg:justify-between">
              <div class="flex max-w-[400px] flex-col items-start gap-6">
                <SectionTitle align="left" tagline={copy['recap.tagline']} heading={copy['recap.heading']} text={copy['recap.text']} />
                <Button href="#photos" variant="outline">{copy['button.text']}</Button>
              </div>
              <div class="lg:w-[800px]">
                <StatTileRow stats={event.recapStats.map((s) => ({ value: s.number, label: s.heading ?? '', caption: s.label }))} />
              </div>
            </div>
          </section>
        )}

        {event.gallery && event.gallery.length > 0 && (
          <section id="photos" class="scroll-mt-8 px-6 pt-16 md:pt-[120px] md:px-[128px]">
            <SectionTitle align="left" tagline={copy['sectionTitle5.tagline']} heading={copy['sectionTitle5.heading']} text={copy['sectionTitle5.text']} />
            <div class="mt-16"><GalleryCarousel photos={event.gallery} /></div>
          </section>
        )}

        {event.sponsors && event.sponsors.length > 0 && (
          <section class="mt-16 md:mt-[120px] bg-neutral-white"><LogoCarousel heading={copy['logoCarousel2.heading']} logos={event.sponsors} /></section>
        )}

        {nextEvent && (
          <section id="next-edition" class="scroll-mt-8 px-6 pt-16 md:pt-[120px] md:px-[296px]">
            <ProgramsCta
              heading={copy['programsCta.heading']}
              text={copy['programsCta.text']}
              primaryCta={{ label: copy['programsCta.label.2'], href: `/events/${nextEvent.slug}` }}
              secondaryCta={{ label: copy['programsCta.label.1'], href: '/contact' }}
            />
          </section>
        )}

        <section class="px-6 pt-16 md:pt-[120px] md:px-20">
          <SectionTitle tagline={copy['sectionTitle6.tagline']} heading={copy['sectionTitle6.heading']} text={copy['sectionTitle6.text']} />
          <div class="mx-auto mt-16 grid max-w-screen-xl gap-6 md:grid-cols-3">
            <PastelCard centered tone="sun" title={copy['pastelCard.title']} body={copy['pastelCard.body']} cta={{ label: copy['pastelCard.label.1'], href: '/sponsor-a-child' }} />
            <PastelCard centered tone="salmon" title={copy['pastelCard2.title']} body={copy['pastelCard2.body']} cta={{ label: copy['pastelCard2.label.1'], href: '/ways-to-give' }} />
            <PastelCard centered tone="sky" title={copy['pastelCard3.title']} body={copy['pastelCard3.body']} cta={{ label: copy['pastelCard3.label.1'], href: '/corporate-sponsorships' }} />
          </div>
        </section>
      </>
    )
  }

  <section class="px-6 pb-16 md:pb-[120px] pt-[60px] md:px-16">
    <div class="mx-auto max-w-[1312px]"><NewsletterSignup width="wide" /></div>
  </section>
</PageLayout>
