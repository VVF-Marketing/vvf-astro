---
// Ways to Give — mirrors the live page (scripts/migrate/snapshot/pages/ways-to-give.json).
import PageLayout from '../../layouts/PageLayout.astro'
import Hero from '../../components/Hero.astro'
import FeatureBand from '../../components/FeatureBand.astro'
import GiftAmountPicker from '../../components/GiftAmountPicker.astro'
import MediaSplit from '../../components/MediaSplit.astro'
import SectionTitle from '../../components/SectionTitle.astro'
import PastelCard from '../../components/PastelCard.astro'
import AppealPanel from '../../components/AppealPanel.astro'
import FaqAccordion from '../../components/FaqAccordion.astro'
import Button from '../../components/Button.astro'
import { getEvents, getFaqs, isUpcoming, getPageCopy } from '../../lib/content'
import { localeFromPath, pageAlternates } from '../../lib/i18n'
import { generalDonationUrl } from '../../lib/donorbox'
import pageCopy from './_copy'

const locale = localeFromPath(Astro.originPathname)

const faqs = await getFaqs('donation', locale)
const nextEvent = (await getEvents(locale)).filter(isUpcoming).sort((a, b) => a.startDate.localeCompare(b.startDate))[0]
const { copy, locales } = await getPageCopy(pageCopy, locale)
---

<PageLayout
  title={copy['seo.title']}
  description={copy['seo.description']}
  image={copy['seo.image']}
  alternates={pageAlternates(pageCopy.route, locales)}
>
  <Hero
    align="right"
    imageUrl="/images/pages/1b2ca82c-98.webp"
    imageAlt={copy['hero.imageAlt']}
    heading={copy['hero.heading']}
    subtext={copy['hero.subtext']}
    primaryCta={{ label: copy['hero.label.1'], href: '#give' }}
    secondaryCta={{ label: copy['hero.label.2'], href: '/sponsor-a-child' }}
  />

  <FeatureBand
    id="give"
    tone="sky"
    tagline={copy['featureBand.tagline']}
    heading={copy['featureBand.heading']}
    text={copy['featureBand.text']}
    imageUrl="/images/pages/6dd3733e-hero-section-picture.jpg"
    imageAlt={copy['featureBand.imageAlt']}
  >
    <GiftAmountPicker baseUrl={generalDonationUrl()} query="utm_source=website&utm_medium=ways-to-give&utm_campaign=give-block" />
    <p class="font-body text-size-md leading-body text-brand-primary">
      {copy['p.text']} <a href="/sponsor-a-child" class="font-bold text-brand-primary underline">{copy['a.text']}</a>
    </p>
    <p class="font-body text-size-sm leading-[1.6] text-brand-primary">
      {copy['p2.text']}
    </p>
  </FeatureBand>

  <MediaSplit
    tagline={copy['mediaSplit.tagline']}
    heading={copy['mediaSplit.heading']}
    text={copy['mediaSplit.text']}
    note={copy['mediaSplit.note']}
    imageUrl="/images/pages/d9d1e4da-8006bc582f67d04432c0e2c17b85765bf066fbaa.jpg"
    imageAlt={copy['mediaSplit.imageAlt']}
  >
    <Button href="/sponsor-a-child/children" variant="primary">{copy['button.text']}</Button>
  </MediaSplit>

  <section class="px-6 pb-16 md:pb-[120px] pt-16 md:pt-[120px] md:px-20">
    <SectionTitle tagline={copy['sectionTitle.tagline']} heading={copy['sectionTitle.heading']} />
    <div class="mx-auto mt-16 grid max-w-screen-xl gap-6 md:grid-cols-3">
      <PastelCard tone="sun" title={copy['pastelCard.title']} body={copy['pastelCard.body']} cta={{ label: copy['pastelCard.label.1'], href: '/corporate-sponsorships' }} />
      <PastelCard tone="salmon" title={copy['pastelCard2.title']} body={copy['pastelCard2.body']} cta={{ label: copy['pastelCard2.label.1'], href: '/contact' }} />
      <PastelCard tone="sky" title={copy['pastelCard3.title']} body={copy['pastelCard3.body']} cta={{ label: copy['pastelCard3.label.1'], href: '/corporate-sponsorships' }} />
    </div>
  </section>

  {
    nextEvent && (
      <FeatureBand
        tone="sun"
        tagline={copy['featureBand2.tagline']}
        heading={nextEvent.title}
        text={nextEvent.description}
        imageUrl="/images/pages/82499f8c-vvf-golf2026-flagphoto-waystogive-v1.webp"
        imageAlt={copy['featureBand2.imageAlt']}
      >
        <Button href={`/events/${nextEvent.slug}`} variant="primary">{copy['button2.text']}</Button>
      </FeatureBand>
    )
  }

  <div class="pt-16 md:pt-[120px]">
    <AppealPanel
      heading={copy['appealPanel.heading']}
      text={copy['appealPanel.text']}
      imageUrl="/images/pages/5547e143-vvf-laguaira-centre-exterior-web-v1.jpg"
      imageAlt={copy['appealPanel.imageAlt']}
      caption={copy['appealPanel.caption']}
      cardsLabel={copy['appealPanel.cardsLabel']}
      cards={[
        { title: copy['appealPanel.title.1'], text: copy['appealPanel.text.1'], imageUrl: '/images/pages/467d8fd3-vvf-laguaira-card-shelter-web-v1.jpg', imageAlt: copy['appealPanel.imageAlt.1'] },
        { title: copy['appealPanel.title.2'], text: copy['appealPanel.text.2'], imageUrl: '/images/pages/2631b854-vvf-laguaira-card-medicalcare-web-v1.jpg', imageAlt: copy['appealPanel.imageAlt.2'] },
        { title: copy['appealPanel.title.3'], text: copy['appealPanel.text.3'], imageUrl: '/images/pages/c84863db-vvf-laguaira-card-nutrition-web-v1.jpg', imageAlt: copy['appealPanel.cards.nutritionAlt'] },
      ]}
      primaryCta={{ label: copy['appealPanel.label.1'], href: '#give' }}
      secondaryCta={{ label: copy['appealPanel.label.2'], href: '/earthquake-relief' }}
    />
  </div>

  <section class="px-6 pb-16 md:pb-[120px] pt-16 md:pt-[120px]">
    <SectionTitle heading={copy['sectionTitle2.heading']} />
    <div class="mt-12"><FaqAccordion faqs={faqs} /></div>
  </section>
</PageLayout>
