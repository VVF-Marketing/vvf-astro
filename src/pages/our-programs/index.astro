---
// Our Programs (spec 7.19), as the live page: hero, how the programs work
// together, the three program blocks, global goals and the videos. Grey
// page background behind the first two sections, white from the programs
// down (spec 5.3).
import PageLayout from '../../layouts/PageLayout.astro'
import Hero from '../../components/Hero.astro'
import SectionTitle from '../../components/SectionTitle.astro'
import ProgramBlock from '../../components/ProgramBlock.astro'
import ImpactBanner from '../../components/ImpactBanner.astro'
import VideoGrid from '../../components/VideoGrid.astro'
import { getPageCopy } from '../../lib/content'
import { localeFromPath, pageAlternates } from '../../lib/i18n'
import pageCopy from './_copy'
import homeCopy from '../_copy'

const locale = localeFromPath(Astro.originPathname)
const { copy, locales } = await getPageCopy(pageCopy, locale)
// The videos are Home's list (spec 7.19, section 7).
const { copy: home } = await getPageCopy(homeCopy, locale)
const c = (key: string) => (copy as Record<string, string>)[key]

const blocks = [
  { id: 'programs', key: 'nutrition', tone: 'sun', photos: ['/images/pages/programs-nutrition-1.webp', '/images/pages/programs-nutrition-2.webp'] },
  { id: 'medical-care', key: 'medical', tone: 'salmon', photos: ['/images/pages/programs-medical-1.webp', '/images/pages/programs-medical-2.webp'] },
  { id: 'education', key: 'education', tone: 'sky', photos: ['/images/pages/programs-education-1.webp'] },
] as const
---

<PageLayout
  title={copy['seo.title']}
  description={copy['seo.description']}
  image={copy['seo.image']}
  alternates={pageAlternates(pageCopy.route, locales)}
>
  <Hero
    imageUrl="/images/pages/programs-nutrition-1.webp"
    imageAlt={copy['hero.imageAlt']}
    heading={copy['hero.heading']}
    subtext={copy['hero.subtext']}
    primaryCta={{ label: copy['hero.cta1'], href: '#programs' }}
    secondaryCta={{ label: copy['hero.cta2'], href: '/ways-to-give' }}
    align="right"
  />

  <section class="px-6 pb-16 md:px-20 md:pb-[120px]">
    <SectionTitle tagline={copy['together.tagline']} heading={copy['together.heading']} text={copy['together.text']} />
  </section>

  <div class="bg-neutral-white">
    {
      blocks.map((b) => (
        <ProgramBlock
          id={b.id}
          tone={b.tone}
          tagline={c(`${b.key}.tagline`)}
          heading={c(`${b.key}.heading`)}
          text={c(`${b.key}.text`)}
          cta={{ label: copy['program.support'], href: '/sponsor-a-child' }}
          photos={b.photos.map((url, i) => ({
            url,
            alt: c(`${b.key}.photo${i + 1}.alt`),
            title: c(`${b.key}.photo${i + 1}.title`),
            text: c(`${b.key}.photo${i + 1}.text`),
          }))}
        />
      ))
    }

    <div class="pt-16 md:pt-[120px]">
      <ImpactBanner
        eyebrow={copy['goals.tagline']}
        heading={copy['goals.heading']}
        body={copy['goals.text']}
        imageUrl="/images/pages/programs-goals-1.webp"
        imageAlt={copy['goals.imageAlt']}
        cta={{ label: copy['goals.cta1'], href: '/ways-to-give' }}
        secondaryCta={{ label: copy['goals.cta2'], href: '/sponsor-a-child' }}
        ctaVariant="primary-inverse"
      />
    </div>

    <div class="py-16 md:py-[120px]">
      <VideoGrid
        heading={copy['videos.heading']}
        text={copy['videos.text']}
        videos={[
          { youtubeId: 'QcC-iVlZDSI', caption: home['videoGrid.caption.1'], description: home['videoGrid.description.1'] },
          { youtubeId: 'D9oa77B6sQk', caption: home['videoGrid.caption.2'], description: home['videoGrid.description.2'] },
          { youtubeId: 'JZkA3l_LDk4', caption: home['videoGrid.caption.3'], description: home['videoGrid.description.3'] },
        ]}
      />
    </div>
  </div>
</PageLayout>
