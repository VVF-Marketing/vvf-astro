---
// Privacy Policy — copy taken verbatim from the live page
// (`.claude_temp-legal_body-section`, sanitized by scripts/migrate).
import PageLayout from '../../layouts/PageLayout.astro'
import RichText from '../../components/RichText.astro'
import body from './_body.html?raw'
---

<PageLayout
  title="Privacy Policy | Victoria Venezuela Foundation"
  description="How Victoria Venezuela Foundation collects, uses, stores and protects information from donors, volunteers, partners and website visitors."
>
  <section class="px-6 pt-16 md:pt-[72px] text-center">
    <p class="font-body text-size-sm font-semibold text-brand-primary">Effective date: July 6th, 2026</p>
    <h1 class="mt-4 text-h2-mobile leading-[1.1] text-brand-primary md:text-h2">Privacy Policy</h1>
  </section>
  <section class="px-6 pb-16 md:pb-[120px] pt-[88px]">
    <RichText html={body} class="mx-auto max-w-[760px]" />
  </section>
</PageLayout>
