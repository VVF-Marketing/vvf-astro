---
// Privacy Policy — copy taken verbatim from the live page
// (`.claude_temp-legal_body-section`, sanitized by scripts/migrate), now the
// rich `body` copy slot (default: _body.json).
import PageLayout from '../../layouts/PageLayout.astro'
import RichText from '../../components/RichText.astro'
import { PortableText } from 'emdash/ui'
import { getPageCopy } from '../../lib/content'
import { localeFromPath, pageAlternates } from '../../lib/i18n'
import pageCopy from './_copy'

const locale = localeFromPath(Astro.originPathname)
const { copy, locales } = await getPageCopy(pageCopy, locale)
---

<PageLayout
  title={copy['seo.title']}
  description={copy['seo.description']}
  image={copy['seo.image']}
  alternates={pageAlternates(pageCopy.route, locales)}
>
  <section class="px-6 pt-16 md:pt-[72px] text-center">
    <p class="font-body text-size-sm font-semibold text-brand-primary">{copy['p.text']}</p>
    <h1 class="mt-4 text-h2-mobile leading-[1.1] text-brand-primary md:text-h2">{copy['h1.text']}</h1>
  </section>
  <section class="px-6 pb-16 md:pb-[120px] pt-[88px]">
    <RichText class="mx-auto max-w-[760px]">
      <PortableText value={copy['body']} />
    </RichText>
  </section>
</PageLayout>
