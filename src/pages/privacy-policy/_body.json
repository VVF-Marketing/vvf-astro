  {
    "_type": "block",
    "_key": "pp3f",
    "style": "normal",
    "children": [
      {
        "_type": "span",
        "_key": "pp3e",
        "text": "VVF proudly serves vulnerable communities, including children and families in Venezuela. We are deeply committed to protecting the privacy, safety, and dignity of minors."
      }
    ]
  },
  {
    "_type": "block",
    "_key": "pp3h",
    "style": "normal",
    "children": [
      {
        "_type": "span",
        "_key": "pp3g",
        "text": "We do not knowingly collect personal data from children via this website. If we discover that a minor has provided us with personal information without valid parental or guardian authorization, we will act swiftly to remove it from our systems."
      }
    ]
  },
  {
    "_type": "block",
    "_key": "pp3j",
    "style": "h2",
