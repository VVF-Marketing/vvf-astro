---
// Team member profile — mirrors the live /team-members/<slug> pages.
import PageLayout from '../../layouts/PageLayout.astro'
import BioCard from '../../components/BioCard.astro'
import { getTeamMemberBySlug } from '../../lib/content'

// One profile per person; when they appear in several tiers,
// getTeamMemberBySlug picks the entry carrying the full bio.
const member = await getTeamMemberBySlug(Astro.params.slug!)
if (!member) return new Response('Not found', { status: 404 })
---

<PageLayout
  title={`${member.name} | Our Team | Victoria Venezuela Foundation`}
  description={`Meet ${member.name}, part of the team at Victoria Venezuela Foundation. Read about their background and their role in our work in Venezuela.`}
  image={member.imageUrl}
>
  <BioCard member={member} />
</PageLayout>
