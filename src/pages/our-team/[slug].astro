---
// Team member profile — mirrors the live /team-members/<slug> pages.
import PageLayout from '../../layouts/PageLayout.astro'
import BioCard from '../../components/BioCard.astro'
import { getPageCopy, getTeamMemberBySlug } from '../../lib/content'
import { alternatePaths, localeFromPath } from '../../lib/i18n'
import { fill } from '../../lib/globalCopy'
import { person } from '../../lib/structuredData'
import pageCopy from './_copy'

const locale = localeFromPath(Astro.originPathname)
// The profile's title and description templates live with the Our Team copy.
const { copy } = await getPageCopy(pageCopy, locale)

// One profile per person; when they appear in several tiers,
// getTeamMemberBySlug picks the entry carrying the full bio.
const member = await getTeamMemberBySlug(Astro.params.slug!, locale)
if (!member) return Astro.rewrite('/404')
---

<PageLayout
  title={fill(copy['profile.seo.title'], { name: member.name })}
  description={fill(copy['profile.seo.description'], { name: member.name })}
  image={member.imageUrl}
  alternates={alternatePaths('/our-team', member.alternates)}
  contentLocale={member.fallbackLocale}
  jsonLd={[person(member, Astro.site ?? Astro.url, new URL(Astro.originPathname, Astro.site ?? Astro.url).href)]}
>
  <BioCard member={member} />
</PageLayout>
