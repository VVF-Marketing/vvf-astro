---
// Home — mirrors the live home page section by section (see
// scripts/migrate/snapshot/pages/home.json).
import PageLayout from '../layouts/PageLayout.astro'
import Hero from '../components/Hero.astro'
import SectionTitle from '../components/SectionTitle.astro'
import StatTileRow from '../components/StatTileRow.astro'
import FeatureCard from '../components/FeatureCard.astro'
import ImpactBanner from '../components/ImpactBanner.astro'
import VideoGrid from '../components/VideoGrid.astro'
import EventCard from '../components/EventCard.astro'
import Eyebrow from '../components/Eyebrow.astro'
import Button from '../components/Button.astro'
import LogoCarousel from '../components/LogoCarousel.astro'
import ProgramsCta from '../components/ProgramsCta.astro'
import { getEvents, getPartners, getReports, getSiteFacts, isUpcoming, latestPast, getPageCopy } from '../lib/content'
import { ngo } from '../lib/structuredData'
import { localeFromPath, pageAlternates } from '../lib/i18n'
import pageCopy from './_copy'

const locale = localeFromPath(Astro.originPathname)

const events = await getEvents(locale)
// Featured upcoming events, soonest first; with none, the latest past event (spec 7.1, section 6).
const upcoming = events.filter((e) => e.featured && isUpcoming(e)).sort((a, b) => a.startDate.localeCompare(b.startDate))
const past = upcoming.length ? undefined : latestPast(events)
const shownEvents = past ? [past] : upcoming
const partners = await getPartners(locale)
// The impact report button follows the newest annual report (spec 7.1, section 2).
const [latestAnnual] = await getReports('annual', locale)
const { copy, locales } = await getPageCopy(pageCopy, locale)
const site = Astro.site ?? Astro.url
// The four impact figures come from the site facts (spec 7.1, section 2).
const facts = await getSiteFacts(locale)
const stat = (key: 'meals_served' | 'medical_visits' | 'children_in_programs' | 'corporate_sponsors', n: number) => ({
  value: facts[key]?.value ?? copy[`statTileRow.value.${n}` as 'statTileRow.value.1'],
  label: facts[key]?.label ?? copy[`statTileRow.label.${n}` as 'statTileRow.label.1'],
  caption: facts[key]?.detail ?? copy[`statTileRow.caption.${n}` as 'statTileRow.caption.1'],
})
---

<PageLayout
  title={copy['seo.title']}
  description={copy['seo.description']}
  image={copy['seo.image']}
  alternates={pageAlternates(pageCopy.route, locales)}
  jsonLd={[ngo(site, copy['seo.description'])]}
>
  <Hero
    imageUrl={copy['hero.image']}
    mobileImageUrl={copy['hero.imagePhone'] || undefined}
    imageAlt={copy['hero.imageAlt']}
    heading={copy['hero.heading']}
    subtext={copy['hero.subtext']}
    primaryCta={{ label: copy['hero.label.1'], href: '/sponsor-a-child' }}
    secondaryCta={{ label: copy['hero.label.2'], href: '/ways-to-give' }}
  />

  <section class="px-6 md:px-20">
    <SectionTitle
      tagline={copy['sectionTitle.tagline']}
      heading={copy['sectionTitle.heading']}
      headingLevel="p"
      text={copy['sectionTitle.text']}
    />
    <div class="mx-auto mt-16 flex max-w-screen-xl flex-col gap-12 lg:flex-row lg:items-start lg:justify-between">
      <div class="flex max-w-[400px] flex-col items-start gap-6">
        <SectionTitle
          align="left"
          tagline={copy['sectionTitle2.tagline']}
          heading={copy['sectionTitle2.heading']}
          text={copy['sectionTitle2.text']}
        />
        <Button href={latestAnnual ? `/resources/${latestAnnual.slug}` : '/financials-and-transparency'} variant="outline">{copy['button.text']}</Button>
      </div>
      <div class="lg:w-[800px]">
        <StatTileRow
          stats={[stat('meals_served', 1), stat('medical_visits', 2), stat('children_in_programs', 3), stat('corporate_sponsors', 4)]}
        />
      </div>
    </div>
  </section>

  <section class="px-6 pb-16 md:pb-[120px] pt-16 md:pt-[120px] md:px-16">
    <SectionTitle
      tagline={copy['sectionTitle3.tagline']}
      heading={copy['sectionTitle3.heading']}
      text={copy['sectionTitle3.text']}
    />
    <!-- 768 to 991px: the cards stack full width so the button stays on one line (spec 7.1, section 3). -->
    <div class="mx-auto mt-16 grid max-w-screen-xl justify-items-center gap-8 lg:grid-cols-3">
      <FeatureCard
        tone="sun"
        iconUrl="/images/pages/b62b0e1d-15-nutrition.svg"
        eyebrow={copy['pastelCard.eyebrow']}
        title={copy['pastelCard.title']}
        body={copy['pastelCard.body']}
        cta={{ label: copy['programs.learnMore'], href: '/our-programs#programs', ariaLabel: `${copy['programs.learnMore']}: ${copy['pastelCard.title']}` }}
      />
      <FeatureCard
        tone="salmon"
        iconUrl="/images/pages/6bbc919e-expanded.svg"
        eyebrow={copy['pastelCard2.eyebrow']}
        title={copy['pastelCard2.title']}
        body={copy['pastelCard2.body']}
        cta={{ label: copy['programs.learnMore'], href: '/our-programs#medical-care', ariaLabel: `${copy['programs.learnMore']}: ${copy['pastelCard2.title']}` }}
      />
      <FeatureCard
        tone="sky"
        iconUrl="/images/pages/a037d128-vector.svg"
        eyebrow={copy['pastelCard3.eyebrow']}
        title={copy['pastelCard3.title']}
        body={copy['pastelCard3.body']}
        cta={{ label: copy['programs.learnMore'], href: '/our-programs#education', ariaLabel: `${copy['programs.learnMore']}: ${copy['pastelCard3.title']}` }}
      />
    </div>
  </section>

  <ImpactBanner
    eyebrow={copy['impactBanner.eyebrow']}
    heading={copy['impactBanner.heading']}
    body={copy['impactBanner.body']}
    bullets={[
      copy['impactBanner.bullets.1'],
      copy['impactBanner.bullets.2'],
      copy['impactBanner.bullets.3'],
    ]}
    imageUrl="/images/pages/d9d1e4da-8006bc582f67d04432c0e2c17b85765bf066fbaa.jpg"
    imageAlt={copy['impactBanner.imageAlt']}
    cta={{ label: copy['impactBanner.label.1'], href: '/children' }}
  />

  <div class="mt-16 md:mt-[120px]">
    <VideoGrid
      heading={copy['videoGrid.heading']}
      text={copy['videoGrid.text']}
      videos={[
        { youtubeId: 'QcC-iVlZDSI', caption: copy['videoGrid.caption.1'] },
        { youtubeId: 'D9oa77B6sQk', caption: copy['videoGrid.caption.2'] },
        { youtubeId: 'JZkA3l_LDk4', caption: copy['videoGrid.caption.3'] },
      ]}
    />
  </div>

  <section class="px-6 pb-16 md:pb-[120px] pt-16">
    <SectionTitle tagline={copy['sectionTitle4.tagline']} heading={copy['sectionTitle4.heading']} />
    {
      shownEvents.length > 0 && (
        <div class="mx-auto mt-16 flex max-w-[1200px] flex-col items-center gap-10">
          <Eyebrow>{past ? copy['events.pastLabel'] : copy['eyebrow.text']}</Eyebrow>
          <div class="flex w-full flex-col gap-6">
            {shownEvents.map((e) => (
              <EventCard event={e} ctaLabel={past ? copy['events.pastButton'] : undefined} />
            ))}
          </div>
        </div>
      )
    }
    <div class="mt-20 flex justify-center">
      <Button href="/events-and-campaigns" variant="primary-inverse">{copy['button2.text']}</Button>
    </div>
  </section>

  {
    partners.length > 0 && (
      <section class="bg-neutral-white py-10 md:py-16">
        <LogoCarousel heading={copy['logoCarousel.heading']} logos={partners} />
      </section>
    )
  }

  <section class="px-4 pb-16 md:pb-[120px] pt-16 md:pt-[120px] md:px-20">
    <ProgramsCta
      heading={copy['programsCta.heading']}
      text={copy['programsCta.text']}
      primaryCta={{ label: copy['programsCta.label.1'], href: '/financials-and-transparency' }}
    />
  </section>
</PageLayout>
