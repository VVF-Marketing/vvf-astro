---
// Contact — mirrors the live page (scripts/migrate/snapshot/pages/contact.json).
// The reach-us cards link to the form with a preselected topic (project
// addition; the live cards are not links).
import PageLayout from '../../layouts/PageLayout.astro'
import Hero from '../../components/Hero.astro'
import SectionTitle from '../../components/SectionTitle.astro'
import Card from '../../components/Card.astro'
import ContactForm from '../../components/ContactForm.astro'
import { getPageCopy } from '../../lib/content'
import { localeFromPath, pageAlternates } from '../../lib/i18n'
import pageCopy from './_copy'

const locale = localeFromPath(Astro.originPathname)
const { copy, locales } = await getPageCopy(pageCopy, locale)

// Contact address doubles as a link target, so it stays in code.
const EMAIL = 'info@victoriavenezuelafoundation.org'

const reachUsCards = [
  { title: copy['reachUs.general.title'], body: copy['reachUs.general.body'], topic: 'general', tone: 'salmon' },
  { title: copy['reachUs.donation.title'], body: copy['reachUs.donation.body'], topic: 'donation-support', tone: 'sky' },
  { title: copy['reachUs.media.title'], body: copy['reachUs.media.body'], topic: 'media-press', tone: 'sun' },
  { title: copy['reachUs.corporate.title'], body: copy['reachUs.corporate.body'], topic: 'corporate-partnerships', tone: 'white' },
] as const

const contactLines = [
  { icon: 'mail', label: EMAIL, href: `mailto:${EMAIL}` },
  { icon: 'phone', label: '+1 (954) 371-0557', href: 'tel:+19543710557' },
  { icon: 'pin', label: copy['contact.address'] },
]
---

<PageLayout
  title={copy['seo.title']}
  description={copy['seo.description']}
  image={copy['seo.image']}
  alternates={pageAlternates(pageCopy.route, locales)}
>
  <Hero
    align="right"
    imageUrl="/images/pages/e15186b8-98.png"
    imageAlt={copy['hero.imageAlt']}
    heading={copy['hero.heading']}
    subtext={copy['hero.subtext']}
    primaryCta={{ label: copy['hero.label.1'], href: '/sponsor-a-child' }}
    secondaryCta={{ label: copy['hero.label.2'], href: '/ways-to-give' }}
  />

  <section class="px-6 md:px-16">
    <SectionTitle tagline={copy['sectionTitle.tagline']} heading={copy['sectionTitle.heading']} text={copy['sectionTitle.text']} />
    <div class="mx-auto mt-16 grid max-w-[1312px] gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        reachUsCards.map((card) => (
          <Card
            href={`/contact?topic=${card.topic}#contact-form`}
            tone={card.tone}
            radius="card"
            class="flex flex-col items-center gap-6 px-10 py-16 text-center no-underline"
            data-reach-us-link={card.topic}
          >
            <h2 class="text-h4-mobile leading-[1.4] text-brand-primary md:text-h4">{card.title}</h2>
            <p class="font-sans text-size-md leading-body text-brand-primary">{card.body}</p>
          </Card>
        ))
      }
    </div>
  </section>

  <section id="contact-form" class="scroll-mt-8 px-6 py-16 md:py-[120px] md:px-20">
    <div class="mx-auto grid max-w-screen-xl items-start gap-10 lg:grid-cols-[540px_1fr]">
      <div class="flex flex-col gap-6 rounded-2xl bg-neutral-white p-8 md:p-16">
        <p class="font-sans text-size-sm font-semibold text-brand-primary">{copy['p2.text']}</p>
        <h2 class="text-h2-mobile leading-[1.2] text-brand-primary md:text-h2">{copy['h22.text']}</h2>
        <p class="font-body text-size-lg leading-body text-brand-primary">
          {copy['p3.text']}
        </p>
        <ul class="mt-4 flex flex-col gap-4">
          {
            contactLines.map((line) => (
              <li class="flex items-center gap-3 font-body text-size-sm text-brand-primary">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" class="shrink-0">
                  {line.icon === 'mail' && <path d="M3 6h18v12H3zM3 6l9 7 9-7" stroke-linejoin="round" />}
                  {line.icon === 'phone' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a1 1 0 01-1 1A16 16 0 014 5a1 1 0 011-1z" stroke-linejoin="round" />}
                  {line.icon === 'pin' && <path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11zM12 12.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z" />}
                </svg>
                {line.href ? <a href={line.href} class="text-brand-primary underline">{line.label}</a> : <span>{line.label}</span>}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-2xl bg-sky p-8 md:px-20 md:py-16">
        <ContactForm />
      </div>
    </div>
  </section>
</PageLayout>

<script>
  // Preselect the form topic from ?topic= (reach-us cards link here).
  const topicSelect = document.querySelector<HTMLSelectElement>('[data-topic-select]')
  const topic = new URLSearchParams(window.location.search).get('topic')
  if (topic && topicSelect) topicSelect.value = topic
</script>
