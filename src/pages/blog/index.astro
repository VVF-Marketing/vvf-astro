---
import PageLayout from '../../layouts/PageLayout.astro'
import BlogCard from '../../components/BlogCard.astro'
import ArticleCard from '../../components/ArticleCard.astro'
import NewsletterSignup from '../../components/NewsletterSignup.astro'
import { getPosts, getFeaturedPosts, getPageCopy } from '../../lib/content'
import { localeFromPath, pageAlternates } from '../../lib/i18n'
import { fill } from '../../lib/globalCopy'
import pageCopy from './_copy'

const locale = localeFromPath(Astro.originPathname)
const { copy, locales } = await getPageCopy(pageCopy, locale)

const posts = await getPosts(undefined, locale)
const featuredSidebar = await getFeaturedPosts(locale)
const featured = posts[0]
// `all` and the post category codes stay in code (the filter matches on them);
// their labels are copy slots.
const categories = ['all', 'Stories', 'Events', 'Financials', 'News'] as const
---

<!-- Project-only page (no live counterpart); styled like the live Resources pages. -->
<PageLayout
  title={copy['seo.title']}
  description={copy['seo.description']}
  image={copy['seo.image']}
  alternates={pageAlternates(pageCopy.route, locales)}
>
  <section class="px-6 pb-16 md:pb-[120px] pt-16 md:pt-[72px] md:px-16">
    <div class="mx-auto max-w-[1312px]">
      <h1 class="text-center text-h2-mobile leading-[1.1] text-brand-primary md:text-h2">{copy['heading']}</h1>

      {
        featured && (
          <div class="mt-12">
            <ArticleCard variant="featured" href={`/blog/${featured.slug}`} title={featured.title} date={featured.publishedAt} excerpt={featured.excerpt} imageUrl={featured.imageUrl} />
          </div>
        )
      }

      <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_413px]">
        <div>
          <div class="flex flex-wrap justify-center gap-3" data-category-pills>
            {
              categories.map((c) => (
                <button
                  type="button"
                  class:list={[
                    'inline-flex items-center rounded-pill border-2 border-brand-accent px-6 py-2 font-sans text-size-md font-bold',
                    c === 'all' ? 'bg-brand-accent text-neutral-white' : 'bg-transparent text-brand-accent',
                  ]}
                  data-category={c}
                >
                  {copy[`filter.${c}`]}
                </button>
              ))
            }
          </div>

          <p class="mt-4 text-center font-body text-size-sm text-brand-primary" data-result-count data-template={copy['resultCount']}>
            {fill(copy['resultCount'], { visible: posts.length, total: posts.length })}
          </p>

          <div class="mt-6 grid gap-6 sm:grid-cols-2" data-post-grid>
            {
              posts.map((post) => (
                <div data-post-card data-category={post.category}>
                  <BlogCard post={post} />
                </div>
              ))
            }
          </div>
        </div>

        <aside class="flex flex-col gap-10">
          <NewsletterSignup />
          {
            featuredSidebar.length > 0 && (
              <div class="flex flex-col gap-6">
                <h2 class="text-h3-mobile leading-[1.2] text-brand-primary">{copy['featured']}</h2>
                {featuredSidebar.map((post) => (
                  <ArticleCard variant="related" href={`/blog/${post.slug}`} title={post.title} imageUrl={post.imageUrl} category={post.category} />
                ))}
              </div>
            )
          }
        </aside>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  const pillsContainer = document.querySelector<HTMLElement>('[data-category-pills]')
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category]'))
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-post-card]'))
  const resultCount = document.querySelector<HTMLElement>('[data-result-count]')
  const total = cards.length

  function applyCategory(category: string) {
    pills.forEach((p) => {
      const active = p.dataset.category === category
      p.classList.toggle('bg-brand-accent', active)
      p.classList.toggle('text-neutral-white', active)
      p.classList.toggle('bg-transparent', !active)
      p.classList.toggle('text-brand-accent', !active)
    })
    let visible = 0
    cards.forEach((card) => {
      const match = category === 'all' || card.dataset.category === category
      card.hidden = !match
      if (match) visible += 1
    })
    if (resultCount) {
      resultCount.textContent = (resultCount.dataset.template ?? '{visible} / {total}')
        .replace('{visible}', String(visible))
        .replace('{total}', String(total))
    }
  }

  pillsContainer?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-category]')
    if (btn?.dataset.category) applyCategory(btn.dataset.category)
  })

  const initialCategory = new URLSearchParams(window.location.search).get('category')
  if (initialCategory) applyCategory(initialCategory)
</script>
