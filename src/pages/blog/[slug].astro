---
import PageLayout from '../../layouts/PageLayout.astro'
import NewsletterSignup from '../../components/NewsletterSignup.astro'
import ArticleCard from '../../components/ArticleCard.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import RichText from '../../components/RichText.astro'
import { getPostBySlug, getFeaturedPosts } from '../../lib/content'

const post = await getPostBySlug(Astro.params.slug!)
if (!post) return new Response('Not found', { status: 404 })
const featuredSidebar = await getFeaturedPosts()
---

<!-- Project-only page (no live counterpart); styled like a live resource article. -->
<PageLayout title={`${post.title} | Victoria Venezuela Foundation`} description={post.excerpt} image={post.imageUrl}>
  <article class="px-6 pb-16 md:pb-[120px] pt-16 md:pt-[72px] md:px-[72px]">
    <div class="mx-auto max-w-[1296px]">
      <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }, { label: post.title }]} />
      <p class="mt-12 font-body text-size-sm font-semibold uppercase tracking-[0.1em] text-brand-accent">
        Last updated {new Date(post.updatedAt ?? post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
      </p>
      <h1 class="mt-4 text-h2-mobile leading-[1.1] text-brand-primary md:text-h2">{post.title}</h1>
      {post.author && <p class="mt-6 font-body text-size-md text-brand-primary">By {post.author}</p>}

      <div class="mt-16 grid gap-16 lg:grid-cols-[768px_1fr] lg:gap-[120px]">
        <div>
          {post.imageUrl && <img src={post.imageUrl} alt="" class="mb-12 w-full rounded-[20px] object-cover" />}
          <RichText>
            {post.body ? post.body.split(/\n{2,}/).map((p) => <p>{p}</p>) : <p>Full article body pending final copy from the foundation.</p>}
          </RichText>
        </div>
        <aside class="flex flex-col gap-16">
          <NewsletterSignup />
          {
            featuredSidebar.filter((p) => p.slug !== post.slug).length > 0 && (
              <div class="flex flex-col gap-6">
                <h2 class="text-h3-mobile leading-[1.2] text-brand-primary">Featured</h2>
                {featuredSidebar
                  .filter((p) => p.slug !== post.slug)
                  .map((p) => (
                    <ArticleCard variant="related" href={`/blog/${p.slug}`} title={p.title} imageUrl={p.imageUrl} category={p.category} />
                  ))}
              </div>
            )
          }
        </aside>
      </div>
    </div>
  </article>
</PageLayout>
