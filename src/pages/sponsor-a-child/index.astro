---
// Sponsor a Child — mirrors the live page (scripts/migrate/snapshot/pages/sponsor-a-child.json).
import PageLayout from '../../layouts/PageLayout.astro'
import Hero from '../../components/Hero.astro'
import SectionTitle from '../../components/SectionTitle.astro'
import Button from '../../components/Button.astro'
import ChildCarousel from '../../components/ChildCarousel.astro'
import PastelCard from '../../components/PastelCard.astro'
import ChecklistPanel from '../../components/ChecklistPanel.astro'
import IconCard from '../../components/IconCard.astro'
import FaqAccordion from '../../components/FaqAccordion.astro'
import ProgramsCta from '../../components/ProgramsCta.astro'
import { getChildren, getFaqs, getPageCopy } from '../../lib/content'
import { localeFromPath, pageAlternates } from '../../lib/i18n'
import pageCopy from './_copy'

const locale = localeFromPath(Astro.originPathname)

const children = (await getChildren(locale)).slice(0, 12)
const faqs = await getFaqs('sponsorship', locale)
const { copy, locales } = await getPageCopy(pageCopy, locale)
---

<PageLayout
  title={copy['seo.title']}
  description={copy['seo.description']}
  image={copy['seo.image']}
  alternates={pageAlternates(pageCopy.route, locales)}
>
  <Hero
    align="right"
    imageUrl="/images/pages/5b51a5f8-98.png"
    mobileImageUrl="/images/pages/91f6fb13-vvf-sponsorarticle-featured-v2.jpg"
    imageAlt={copy['hero.imageAlt']}
    heading={copy['hero.heading']}
    subtext={copy['hero.subtext']}
    primaryCta={{ label: copy['hero.label.1'], href: '/sponsor-a-child/children' }}
    secondaryCta={{ label: copy['hero.label.2'], href: '#how-it-works' }}
  />

  <section class="px-6 md:px-20">
    <SectionTitle
      tagline={copy['sectionTitle.tagline']}
      heading={copy['sectionTitle.heading']}
      text={copy['sectionTitle.text']}
    >
      <div class="flex flex-wrap justify-center gap-8 pt-6">
        <Button href="/sponsor-a-child/children" variant="primary-inverse">{copy['button.text']}</Button>
        <Button href="#how-it-works" variant="outline">{copy['button2.text']}</Button>
      </div>
    </SectionTitle>
    <img
      src="/images/pages/ae149422-15d77ffd-ad0c-4914-a5cb-538fd74e2f6e-1.png"
      alt={copy['img.alt']}
      class="mx-auto mt-16 aspect-[1280/854] w-full max-w-screen-xl rounded-2xl object-cover"
    />
  </section>

  <section class="pt-16 md:pt-[120px]">
    <SectionTitle tagline={copy['sectionTitle2.tagline']} heading={copy['sectionTitle2.heading']} text={copy['sectionTitle2.text']} />
    {children.length > 0 && <div class="mt-16"><ChildCarousel items={children} /></div>}
    <div class="mt-16 flex justify-center">
      <Button href="/sponsor-a-child/children" variant="primary-inverse">{copy['button3.text']}</Button>
    </div>
  </section>

  <section id="how-it-works" class="px-6 pt-16 md:pt-[120px] md:px-16">
    <SectionTitle tagline={copy['sectionTitle3.tagline']} heading={copy['sectionTitle3.heading']} text={copy['sectionTitle3.text']} />
    <div class="mx-auto mt-20 grid max-w-[1312px] justify-items-center gap-8 md:grid-cols-3">
      <PastelCard tone="sun" iconUrl="/images/pages/13e19084-uuid-b16d0e76-bdc8-400e-a421-98f3d0ed3307.svg" eyebrow={copy['pastelCard.eyebrow']} title={copy['pastelCard.title']} body={copy['pastelCard.body']} />
      <PastelCard tone="salmon" iconUrl="/images/pages/18e3545d-uuid-fbb82aa0-466c-47ff-bed6-28fb0d6195ab.svg" eyebrow={copy['pastelCard2.eyebrow']} title={copy['pastelCard2.title']} body={copy['pastelCard2.body']} />
      <PastelCard tone="sky" iconUrl="/images/pages/13e19084-uuid-b16d0e76-bdc8-400e-a421-98f3d0ed3307.svg" eyebrow={copy['pastelCard3.eyebrow']} title={copy['pastelCard3.title']} body={copy['pastelCard3.body']} />
    </div>
  </section>

  <div class="mt-16 md:mt-[120px]">
    <ChecklistPanel
      tagline={copy['checklistPanel.tagline']}
      heading={copy['checklistPanel.heading']}
      text={copy['checklistPanel.text']}
      items={[
        { title: copy['checklistPanel.items.1'], text: copy['checklistPanel.items.2'] },
        { title: copy['checklistPanel.items.3'], text: copy['checklistPanel.items.4'] },
        { title: copy['checklistPanel.items.5'], text: copy['checklistPanel.items.6'] },
        { title: copy['checklistPanel.items.7'], text: copy['checklistPanel.items.8'] },
      ]}
    />
  </div>

  <section class="px-6 pt-16 md:pt-[160px] md:px-20">
    <SectionTitle
      tagline={copy['sectionTitle4.tagline']}
      heading={copy['sectionTitle4.heading']}
      text={copy['sectionTitle4.text']}
    />
    <div class="mx-auto mt-20 grid max-w-screen-xl gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <IconCard iconUrl="/images/pages/f11a8c87-vvf-icon-reward-letters-v1.svg" title={copy['iconCard.title']} text={copy['iconCard.text']} />
      <IconCard iconUrl="/images/pages/45ed50ce-vvf-icon-reward-photos-v1.svg" title={copy['iconCard2.title']} text={copy['iconCard2.text']} />
      <IconCard iconUrl="/images/pages/221ee42b-vvf-icon-reward-prayer-v1.svg" title={copy['iconCard3.title']} text={copy['iconCard3.text']} />
      <IconCard iconUrl="/images/pages/2543e1f7-vvf-icon-reward-report-v1.svg" title={copy['iconCard4.title']} text={copy['iconCard4.text']} />
    </div>
    <div class="mt-20 flex justify-center">
      <Button href="/sponsor-a-child/children" variant="primary-inverse">{copy['button4.text']}</Button>
    </div>
  </section>

  <section class="px-6 pt-16 md:pt-[120px]">
    <SectionTitle tagline={copy['sectionTitle5.tagline']} heading={copy['sectionTitle5.heading']} text={copy['sectionTitle5.text']} />
    <div class="mt-16">
      <FaqAccordion faqs={faqs} />
    </div>
    <div class="mx-auto mt-16 grid max-w-3xl gap-8 md:grid-cols-2">
      <h2 class="text-h2-mobile leading-[1.1] text-brand-primary md:text-h2">{copy['h2.text']}</h2>
      <div class="flex flex-col items-start gap-16">
        <p class="font-body text-size-md leading-body text-brand-primary">
          {copy['p.text']}
        </p>
        <Button href="/contact" variant="primary-inverse">{copy['button5.text']}</Button>
      </div>
    </div>
  </section>

  <section class="px-6 pb-16 md:pb-[120px] pt-16 md:pt-[120px] md:px-[272px]">
    <ProgramsCta
      heading={copy['programsCta.heading']}
      text={copy['programsCta.text']}
      primaryCta={{ label: copy['programsCta.label.1'], href: '/sponsor-a-child/children' }}
      secondaryCta={{ label: copy['programsCta.label.2'], href: '/resources/category/financials-transparency' }}
    />
  </section>
</PageLayout>
