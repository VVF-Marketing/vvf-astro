---
import PageLayout from '../../../layouts/PageLayout.astro'
import ChildCard from '../../../components/ChildCard.astro'
import SectionTitle from '../../../components/SectionTitle.astro'
import { getChildren, getPageCopy } from '../../../lib/content'
import { localeFromPath, pageAlternates } from '../../../lib/i18n'
import { CHILD_AGE_RANGES } from '../../../lib/content/types'
import pageCopy from './_copy'

const locale = localeFromPath(Astro.originPathname)

const children = await getChildren(locale)
const { copy, locales } = await getPageCopy(pageCopy, locale)
---

<PageLayout
  title={copy['seo.title']}
  description={copy['seo.description']}
  image={copy['seo.image']}
  alternates={pageAlternates(pageCopy.route, locales)}
>
  <!-- Live counterpart: /sponsor-a-child-list-page (`.children-list_section`).
       The name/age filters are a project addition with no live counterpart. -->
  <section class="bg-neutral-white px-6 pb-16 md:pb-[120px] pt-16 md:pt-[120px] md:px-16">
    <SectionTitle
      tagline={copy['sectionTitle.tagline']}
      heading={copy['sectionTitle.heading']}
      text={copy['sectionTitle.text']}
      headingLevel="h1"
    />

    <div class="mx-auto mt-12 flex max-w-screen-xl flex-wrap items-center justify-center gap-4" data-child-filters>
      <label class="sr-only" for="child-name-filter">{copy['label.text']}</label>
      <input
        id="child-name-filter"
        type="search"
        placeholder={copy['input.placeholder']}
        class="h-[38px] rounded-pill border border-brand-primary bg-transparent px-5 font-sans text-size-sm text-brand-primary placeholder:text-brand-primary/50"
        data-name-filter
      />
      <fieldset class="flex flex-wrap gap-2">
        <legend class="sr-only">{copy['legend.text']}</legend>
        {
          CHILD_AGE_RANGES.map((range) => (
            <label class="flex cursor-pointer items-center gap-1 rounded-pill border border-brand-primary px-3 py-1 font-sans text-size-sm text-brand-primary has-[:checked]:bg-sky">
              <input type="checkbox" value={range} data-age-filter class="accent-brand-primary" />
              {range}
            </label>
          ))
        }
      </fieldset>
    </div>

    <div class="mx-auto mt-12 grid max-w-[1312px] gap-6 sm:grid-cols-2 lg:grid-cols-4" data-child-grid>
      {
        children.map((child) => (
          <div data-child-card data-name={child.displayName.toLowerCase()} data-age={child.age}>
            <ChildCard child={child} />
          </div>
        ))
      }
    </div>

    <p class="mt-6 text-center font-body text-size-sm text-brand-primary" data-empty-state hidden>
      {copy['p.text']}
    </p>
  </section>
</PageLayout>

<script>
  import { childMatchesFilters } from '../../../lib/childFilter'
  import type { ChildAgeRange } from '../../../lib/content/types'

  const nameInput = document.querySelector<HTMLInputElement>('[data-name-filter]')
  const ageInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-age-filter]'))
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-child-card]'))
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]')

  function applyFilters() {
    const nameQuery = nameInput?.value ?? ''
    const ageRanges = ageInputs.filter((i) => i.checked).map((i) => i.value as ChildAgeRange)

    let visibleCount = 0
    cards.forEach((card) => {
      const match = childMatchesFilters(
        { displayName: card.dataset.name ?? '', age: Number(card.dataset.age) },
        { nameQuery, ageRanges }
      )
      card.hidden = !match
      if (match) visibleCount += 1
    })
    if (emptyState) emptyState.hidden = visibleCount > 0
  }

  nameInput?.addEventListener('input', applyFilters)
  ageInputs.forEach((i) => i.addEventListener('change', applyFilters))
</script>
