---
// Live counterpart: `.navbar` (Webflow w-nav). Navy bar, white Nunito links
// that turn cyan on hover, navy dropdown panels, Donate + Contact Us CTAs.
// Collapses into a menu button below the `lg` (992px) breakpoint, like the
// live site. Menu items come from the EmDash `primary` menu (per locale). The
// language switch (EN | ES, as on the live site) links to this page in each
// locale — its translated slug when the page passes `alternates`.
import { getPrimaryMenu } from '../lib/content'
import { LANG_TAGS, LOCALES, localeFromPath, localizePath, stripLocale, type Locale } from '../lib/i18n'
import Button from './Button.astro'
import { getGlobalCopy } from '../lib/globalCopy'

const t = await getGlobalCopy(Astro)

interface Props {
  alternates?: Partial<Record<Locale, string>>
}

const locale = localeFromPath(Astro.originPathname)
// English path of this page; Spanish menu urls carry /es, so compare without it.
const currentPath = stripLocale(Astro.originPathname.replace(/\/$/, '') || '/')
// Each language is named in itself for its accessible name.
const LANGUAGE_NAMES: Record<Locale, string> = { en: 'English', es: 'Español' }
const localeLinks = LOCALES.map((l) => ({
  locale: l,
  href: Astro.props.alternates?.[l] ?? localizePath(currentPath, l),
  current: l === locale,
}))

const items = await getPrimaryMenu(locale)
const isCurrent = (href: string) => {
  if (href === '#') return false
  const url = stripLocale(href)
  return url === currentPath || (url !== '/' && currentPath.startsWith(`${url}/`))
}
const linkClass = 'block whitespace-nowrap font-sans text-size-md font-normal leading-body text-neutral-white no-underline hover:text-brand-accent'
---

<header class="relative z-50 bg-brand-primary px-6 py-5 md:px-8 lg:px-16" data-site-header>
  <div class="mx-auto flex max-w-screen-xl items-center justify-between gap-6 xl:gap-16">
    <a href="/" class="shrink-0" aria-label={t['header.homeLink']}>
      <img src="/images/logo.svg" alt={t['header.logoAlt']} width="206" height="68" class="h-10 w-auto sm:h-[68px]" />
    </a>

    <nav aria-label={t['header.navLabel']} class="hidden flex-1 items-center justify-end gap-2 lg:flex">
      <ul class="flex items-center gap-2">
        {
          items.map((item, i) =>
            item.children?.length ? (
              <li class="group relative" data-dropdown>
                <button
                  type="button"
                  class={`${linkClass} flex items-center gap-1.5 px-3 py-5 xl:px-5`}
                  aria-expanded="false"
                  aria-controls={`nav-dropdown-${i}`}
                  data-dropdown-toggle
                >
                  {item.label}
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" class="transition-transform group-[.is-open]:rotate-180">
                    <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" />
                  </svg>
                </button>
                <ul
                  id={`nav-dropdown-${i}`}
                  class="absolute left-0 top-full hidden min-w-[220px] flex-col rounded-md bg-brand-primary py-2 group-hover:flex group-[.is-open]:flex"
                  data-dropdown-menu
                >
                  {item.children.map((child) => (
                    <li>
                      <a href={child.url} class={`${linkClass} px-5 py-2.5`} aria-current={isCurrent(child.url) ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.url} class={`${linkClass} px-3 py-5 xl:px-5`} aria-current={isCurrent(item.url) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
      <div class="flex shrink-0 items-center gap-4 pl-6 xl:gap-6 xl:pl-16">
        <ul class="flex items-center gap-2" aria-label={t['header.languageLabel']}>
          {localeLinks.map((l) => (
            <li>
              <a
                href={l.href}
                hreflang={LANG_TAGS[l.locale]}
                lang={LANG_TAGS[l.locale]}
                aria-label={LANGUAGE_NAMES[l.locale]}
                aria-current={l.current ? 'true' : undefined}
                class={`${linkClass} ${l.current ? 'font-bold text-brand-accent' : ''}`}
              >
                {l.locale.toUpperCase()}
              </a>
            </li>
          ))}
        </ul>
        <Button href="/ways-to-give" variant="primary">{t['header.donate']}</Button>
        <Button href="/contact" variant="outline">{t['header.contact']}</Button>
      </div>
    </nav>

    <button
      type="button"
      class="p-3 text-neutral-white lg:hidden"
      aria-label={t['header.menuButton']}
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-menu-toggle
    >
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" aria-label={t['header.navLabel']} class="absolute inset-x-0 top-full hidden bg-brand-primary px-6 pb-6 lg:hidden" data-mobile-menu>
    <ul class="flex flex-col">
      {
        items.map((item) =>
          item.children?.length ? (
            <li>
              <p class="py-3 font-sans text-size-md font-bold text-neutral-white">{item.label}</p>
              <ul>
                {item.children.map((child) => (
                  <li>
                    <a href={child.url} class={`${linkClass} py-2.5 pl-10`} aria-current={isCurrent(child.url) ? 'page' : undefined}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={item.url} class={`${linkClass} py-3`} aria-current={isCurrent(item.url) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          )
        )
      }
    </ul>
    <ul class="flex gap-4 py-3" aria-label={t['header.languageLabel']}>
      {localeLinks.map((l) => (
        <li>
          <a
            href={l.href}
            hreflang={LANG_TAGS[l.locale]}
            lang={LANG_TAGS[l.locale]}
            aria-label={LANGUAGE_NAMES[l.locale]}
            aria-current={l.current ? 'true' : undefined}
            class={`${linkClass} ${l.current ? 'font-bold text-brand-accent' : ''}`}
          >
            {l.locale.toUpperCase()}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-4 flex flex-col gap-2">
      <Button href="/ways-to-give" variant="primary">{t['header.donate']}</Button>
      <Button href="/contact" variant="outline">{t['header.contact']}</Button>
    </div>
  </nav>
</header>

<script>
  import { initSiteHeader } from '../lib/siteHeader'

  document.querySelectorAll<HTMLElement>('[data-site-header]').forEach(initSiteHeader)
</script>
