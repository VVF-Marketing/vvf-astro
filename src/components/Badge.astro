---
// Live counterpart: `.tag_component` — small gray label (event dates,
// resource categories).
export interface Props {
  class?: string
}

const { class: className = '' } = Astro.props as Props
---

<span class={`inline-flex items-center rounded-sm bg-neutral-light-gray px-2 py-1 font-sans text-size-sm leading-body text-brand-primary ${className}`}>
  <slot />
</span>
