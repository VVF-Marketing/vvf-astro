---
import Button from './Button.astro'
import Card from './Card.astro'
import TextField from './TextField.astro'

export interface Props {
  presets?: number[]
  currency?: string
  defaultCadence?: 'one-time' | 'monthly'
  sponsorTargetLabel?: string
  actionUrl: string
}

const {
  presets = [25, 50, 100, 250, 500, 1000],
  currency = 'USD',
  defaultCadence = 'one-time',
  sponsorTargetLabel,
  actionUrl,
} = Astro.props as Props
---

<Card class="p-6" data-donation-widget>
  <div class="flex w-fit rounded-pill bg-neutral-100 p-1">
    <button
      type="button"
      class="rounded-pill px-4 py-1 font-sans text-size-sm font-semibold text-brand-primary"
      data-cadence="one-time"
      aria-pressed={defaultCadence === 'one-time'}
    >
      One time
    </button>
    <button
      type="button"
      class="rounded-pill px-4 py-1 font-sans text-size-sm font-semibold text-brand-primary"
      data-cadence="monthly"
      aria-pressed={defaultCadence === 'monthly'}
    >
      Monthly
    </button>
  </div>

  <p class="mt-4 font-body text-size-sm text-brand-primary/70">{currency}</p>

  <div class="mt-2 grid grid-cols-3 gap-2">
    {
      presets.map((p) => (
        <button type="button" class="rounded-pill border border-brand-primary px-3 py-2 font-sans text-size-sm font-semibold text-brand-primary" data-preset={p}>
          {p} {currency}
        </button>
      ))
    }
  </div>

  <TextField
    type="number"
    min="1"
    placeholder={`Custom amount (${currency})`}
    class="mt-3 w-full"
    data-custom-amount
  />

  {
    sponsorTargetLabel && (
      <p class="mt-4 font-body text-size-sm text-brand-primary">
        Sponsoring: <span class="font-semibold">{sponsorTargetLabel}</span>
      </p>
    )
  }

  <Button href={actionUrl} variant="primary" size="lg" class="mt-6 block text-center" data-continue>
    Continue
  </Button>
</Card>

<script>
  import { selectPreset, setCustomValue, type AmountState } from '../lib/donationWidget'

  document.querySelectorAll<HTMLElement>('[data-donation-widget]').forEach((widget) => {
    const cadenceButtons = Array.from(widget.querySelectorAll<HTMLButtonElement>('[data-cadence]'))
    const presetButtons = Array.from(widget.querySelectorAll<HTMLButtonElement>('[data-preset]'))
    const customInput = widget.querySelector<HTMLInputElement>('[data-custom-amount]')

    let state: AmountState = { activePreset: null, customValue: '' }

    function render() {
      presetButtons.forEach((b) => {
        const active = Number(b.dataset.preset) === state.activePreset
        b.classList.toggle('bg-brand-accent', active)
        b.classList.toggle('text-neutral-white', active)
        b.setAttribute('aria-pressed', String(active))
      })
      if (customInput && customInput.value !== state.customValue) customInput.value = state.customValue
    }

    cadenceButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        cadenceButtons.forEach((b) => {
          const active = b === btn
          b.setAttribute('aria-pressed', String(active))
          b.classList.toggle('bg-brand-accent', active)
          b.classList.toggle('text-neutral-white', active)
        })
      })
    })

    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        state = selectPreset(state, Number(btn.dataset.preset))
        render()
      })
    })

    customInput?.addEventListener('input', () => {
      state = setCustomValue(state, customInput.value)
      render()
    })
  })
</script>
