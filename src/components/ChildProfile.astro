---
// Live counterpart: `.section_child-detail` — breadcrumb, name on a sky
// card over the photo, four pastel fact cards (age, birthday, gender,
// dream) with icons, the donation form on the right, and "About <name>"
// below.
import type { ChildItem } from '../lib/content/types'
import Breadcrumbs from './Breadcrumbs.astro'

export interface Props {
  child: ChildItem
}

const { child } = Astro.props as Props
const birthdayLabel = child.birthday
  ? new Date(child.birthday).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : undefined

const facts = [
  { key: 'age', label: 'Age', value: `${child.age} years old`, tone: 'bg-salmon' },
  { key: 'birthday', label: 'Birthday', value: birthdayLabel, tone: 'bg-sun' },
  { key: 'gender', label: 'Gender', value: child.gender, tone: 'bg-sky' },
  { key: 'dream', label: 'Dream', value: child.dream, tone: 'bg-salmon' },
].filter((f) => f.value)
---

<section class="px-6 py-12 lg:px-[95px]">
  <Breadcrumbs items={[{ label: 'Sponsor a Child', href: '/sponsor-a-child' }, { label: child.displayName }]} />

  <div class="mt-12 grid gap-6 lg:mt-[71px] lg:grid-cols-[483fr_294fr_425fr]">
    <div class="flex flex-col gap-6">
      <div class="rounded-[20px] bg-sky p-6">
        <h1 class="text-h1-mobile leading-[1.1] text-brand-primary md:text-h1">{child.displayName}</h1>
      </div>
      {
        child.imageUrl && (
          <img src={child.imageUrl} alt={child.imageAlt ?? `Photo of ${child.displayName}`} class="aspect-[483/604] w-full rounded-[20px] object-cover" />
        )
      }
    </div>

    <ul class="grid content-start gap-6 sm:grid-cols-2 lg:grid-cols-1">
      {
        facts.map((f) => (
          <li class={`flex flex-col gap-4 rounded-[20px] px-8 py-6 ${f.tone}`}>
            <img src={`/images/child/${f.key}.svg`} alt="" width="30" height="31" />
            <p class="font-sans text-h5 font-extrabold leading-[1.45] text-brand-primary">
              {f.label}:<br />
              {f.value}
            </p>
          </li>
        ))
      }
    </ul>

    <div class="lg:row-span-2">
      <slot name="donation" />
    </div>

    {
      child.about && (
        <div class="lg:col-span-2">
          <h2 class="text-h3-mobile leading-[1.5] text-brand-primary md:text-[2rem]">About {child.displayName}</h2>
          {child.about.split(/\n{2,}/).map((p) => (
            <p class="font-body text-size-md leading-body text-brand-primary">{p}</p>
          ))}
        </div>
      )
    }
  </div>
</section>
