---
// Live counterpart: `.section_hero` + `.hero_card`. Full-bleed photo with a
// white rounded card on the left (desktop); on mobile the photo sits on top
// and the card overlaps it, centered.
import Button from './Button.astro'

export interface CtaLink {
  label: string
  href: string
}

export interface Props {
  imageUrl?: string
  mobileImageUrl?: string
  imageAlt?: string
  heading: string
  subtext?: string
  primaryCta?: CtaLink
  secondaryCta?: CtaLink
  // Side the card sits on at desktop (live pages use both).
  align?: 'left' | 'right'
  // Drop the 120px gap below the hero when the next section starts flush
  // against it (e.g. Our Team).
  flush?: boolean
}

const { imageUrl, mobileImageUrl, imageAlt = '', heading, subtext, primaryCta, secondaryCta, align = 'left', flush = false } = Astro.props as Props
const cardPosition = align === 'right' ? 'md:ml-auto md:mr-20' : 'md:ml-20'
---

<section class={`relative flex items-start pt-[230px] md:min-h-[768px] md:items-center md:pt-0 ${flush ? '' : 'mb-8 md:mb-[120px]'}`}>
  {
    imageUrl && (
      <picture>
        {mobileImageUrl && <source media="(max-width: 767px)" srcset={mobileImageUrl} />}
        <img src={imageUrl} alt={imageAlt} class="absolute inset-x-0 top-0 h-[355px] w-full object-cover md:inset-0 md:h-full" />
      </picture>
    )
  }
  <div class={`relative z-10 w-full px-6 md:w-auto md:px-0 md:py-20 ${cardPosition}`}>
    <div class="flex max-w-[608px] flex-col items-center gap-10 rounded-2xl bg-neutral-white px-6 py-10 text-center md:items-start md:px-16 md:py-20 md:text-left">
      <div class="flex flex-col gap-4">
        <h1 class="text-[2.25rem] leading-[1.16] md:text-[3rem]">{heading}</h1>
        {subtext && <p class="font-sans text-size-base leading-body">{subtext}</p>}
      </div>
      {
        (primaryCta || secondaryCta) && (
          <div class="flex w-[200px] flex-col gap-4 md:w-auto md:flex-row md:gap-[18px]">
            {primaryCta && (
              <Button href={primaryCta.href} variant="primary-inverse">
                {primaryCta.label}
              </Button>
            )}
            {secondaryCta && (
              <Button href={secondaryCta.href} variant="outline">
                {secondaryCta.label}
              </Button>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
