---
// Live counterpart: event "Tournament Includes" (`.div-blue-frame.is-two-col`)
// — navy panel (radius 2xl) with the heading on the left and a sky card of
// checked items on the right.
export interface Props {
  heading: string
  items: string[]
}

const { heading, items } = Astro.props as Props
---

<section class="px-0 sm:px-6 md:px-20">
  <div class="mx-auto grid max-w-screen-xl gap-10 rounded-xl bg-brand-primary p-8 md:grid-cols-2 md:rounded-2xl md:p-16">
    <h2 class="text-h3-mobile leading-[1.2] text-neutral-white md:text-h2">{heading}</h2>
    <ul class="flex flex-col gap-6 rounded-2xl bg-sky px-10 py-16 md:px-20">
      {
        items.map((item) => (
          <li class="flex gap-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="mt-1 shrink-0 text-brand-primary">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
              <path d="M8 12.5l2.5 2.5L16 9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="font-sans text-h5 font-extrabold leading-[1.4] text-brand-primary md:text-[1.75rem]">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
