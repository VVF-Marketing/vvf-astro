---
// Live counterpart: `.title_tagline` — small uppercase Open Sans label in
// the accent color above section headings.
export interface Props {
  // `light` for navy/dark sections.
  tone?: 'accent' | 'light'
  class?: string
}

const { tone = 'accent', class: className = '' } = Astro.props as Props
const tones = { accent: 'text-brand-accent', light: 'text-neutral-white' }
---

<p class={`font-body text-size-sm font-semibold uppercase leading-body tracking-[0.1em] ${tones[tone]} ${className}`}>
  <slot />
</p>
