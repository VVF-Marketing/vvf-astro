---
// Live counterpart: Corporate Sponsorships Double the Donation search
// (`#dd-container`). Uses the same public plugin key as the live site; set
// DTD_PUBLIC_KEY to override it (read at runtime).
import { DTD_PUBLIC_KEY } from 'astro:env/server'

const LIVE_DTD_KEY = 'q4dPt5DdwaU9OIyi'
const dtdPublicKey = DTD_PUBLIC_KEY ?? LIVE_DTD_KEY
---

<div class="mx-auto max-w-screen-xl font-poppins text-brand-primary" data-double-the-donation-widget>
  <script is:inline define:vars={{ dtdPublicKey }}>
    window.DDCONF = { API_KEY: dtdPublicKey }
  </script>
  <script is:inline src="https://doublethedonation.com/api/js/ddplugin.js"></script>
  <div id="dd-container" class="text-center font-sans text-size-sm">
    <a href="https://doublethedonation.com/matching-grant-resources/matching-gift-basics/">Matching Gift</a>
    and
    <a href="https://doublethedonation.com/matching-grant-resources/volunteer-grant-basics/">Volunteer Grant</a>
    information provided by<br />
    <a href="https://doublethedonation.com">
      <img src="https://doublethedonation.com/api/img/powered-by.png" alt="Powered by Double the Donation" class="mx-auto" />
    </a>
  </div>
</div>
