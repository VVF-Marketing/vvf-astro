---
// Live counterpart: event `.offer-list` card (`.div-block-71`) — pastel card
// (radius 2xl) with "Name $price" heading, a benefit list and an outline
// navy button. Live cycles sun → sky → salmon across a row of cards.
import Button from './Button.astro'
import { getGlobalCopy } from '../lib/globalCopy'

const t = await getGlobalCopy(Astro)

export interface Props {
  tierName: string
  price?: string
  features?: string[]
  href: string
  ctaLabel?: string
  soldOut?: boolean
  tone?: 'sun' | 'sky' | 'salmon'
}

const { tierName, price, features = [], href, ctaLabel = t['card.buyTickets'], soldOut = false, tone = 'sun' } = Astro.props as Props
const tones = { sun: 'bg-sun', sky: 'bg-sky', salmon: 'bg-salmon' }
---

<article class={`flex w-full max-w-[552px] flex-col gap-6 rounded-2xl p-10 md:p-16 ${tones[tone]}`}>
  <h3 class="text-h5 leading-[1.4] text-brand-primary sm:text-h4">
    {tierName}{price && <span class="ml-1">{price}</span>}
  </h3>
  {
    features.length > 0 && (
      <ul class="flex list-disc flex-col gap-1 pl-[30px] marker:text-size-xs">
        {features.map((f) => (
          <li class="font-body text-size-md leading-body text-brand-primary">{f}</li>
        ))}
      </ul>
    )
  }
  {
    soldOut ? (
      <p class="font-sans text-size-md font-bold text-brand-primary">{t['card.soldOut']}</p>
    ) : (
      <Button href={href} variant="outline-navy" class="self-start">
        {ctaLabel}
      </Button>
    )
  }
</article>
