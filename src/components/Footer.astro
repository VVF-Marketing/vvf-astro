---
// Live counterpart: `.footer_component` — an inset navy card (radius 2xl)
// with logo, legal copy and Candid seal on the left; two link columns,
// contact details and social icons on the right; credits row below.
const linkColumns = [
  [
    { label: 'Our Team', href: '/our-team' },
    { label: 'Sponsor a Child', href: '/sponsor-a-child' },
    { label: 'Ways to Give', href: '/ways-to-give' },
    { label: 'Corporate Sponsorships', href: '/corporate-sponsorships' },
    { label: 'Events', href: '/events' },
  ],
  [
    { label: 'Earthquake relief', href: '/earthquake-relief' },
    { label: 'News', href: '/resources' },
    { label: 'Financials', href: '/resources/category/financials-transparency' },
    { label: 'Donate now', href: '/ways-to-give' },
    { label: 'Contact us', href: '/contact' },
  ],
]

const socialLinks = [
  { label: 'Facebook', href: 'https://www.facebook.com/victoriavenezuelafoundation', icon: '/images/footer/facebook.svg' },
  { label: 'Instagram', href: 'https://www.instagram.com/victoriavenezuelafoundation/', icon: '/images/footer/instagram.svg' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/victoriavenezuelafoundation/posts/?feedView=all', icon: '/images/footer/linkedin.svg' },
  { label: 'YouTube', href: 'https://www.youtube.com/channel/UC5EnslQqm_S4KHb1_T3hnew', icon: '/images/footer/youtube.svg' },
]

const text = 'font-sans text-size-sm leading-body text-neutral-white'
const link = `${text} no-underline hover:text-brand-accent`
const credit = 'font-sans text-size-xs leading-body text-neutral-white sm:text-size-sm'
---

<footer class="px-0 pb-6 sm:px-6 lg:px-6">
  <div class="mx-auto flex flex-col gap-16 rounded-xl bg-brand-primary px-6 py-10 md:rounded-[1.5rem] md:px-6 lg:rounded-2xl lg:p-12 xl:p-16">
    <div class="flex flex-col gap-8 md:flex-row md:flex-wrap lg:flex-nowrap lg:gap-16">
      <div class="flex flex-col items-start gap-4 md:items-start lg:flex-1 lg:gap-8">
        <a href="/" aria-label="Victoria Venezuela Foundation home">
          <img src="/images/logo.svg" alt="Victoria Venezuela Foundation" width="206" height="68" class="h-auto max-w-[180px] md:max-w-none" />
        </a>
        <p class={`${text} max-w-[560px]`}>
          Victoria Venezuela Foundation is a 501(c)(3) non-profit organization.<br />
          Contributions are tax-deductible under Internal Revenue Code Section 501(c)(3).
        </p>
        <p class={text}>
          Tax ID: 88-3282100<br />
          P.O. Box 327222<br />
          Weston, FL 33332
        </p>
        <div class="flex items-center gap-6">
          <a href="https://app.candid.org/profile/14579501/victoria-venezuela-foundation-inc" class="shrink-0">
            <img src="/images/footer/candid-seal.png" alt="Candid Platinum Transparency seal, 2023 to 2026" width="99" height="99" class="h-auto max-w-[100px]" loading="lazy" />
          </a>
          <p class={`${text} max-w-[220px]`}>Candid's Platinum Transparency Recipients 2023-2026</p>
        </div>
      </div>

      <div class="flex flex-col gap-8 lg:max-w-[400px] lg:flex-1 lg:justify-between">
        <div class="grid grid-cols-2 gap-x-6 gap-y-4 md:flex md:flex-wrap lg:flex-nowrap">
          {
            linkColumns.map((column) => (
              <ul class="flex min-w-0 flex-1 flex-col">
                {column.map((item) => (
                  <li>
                    <a href={item.href} class={`${link} flex min-h-11 items-center py-2 md:block md:min-h-0`}>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
        <div class="flex flex-col gap-1">
          <p class={`${text} font-semibold uppercase tracking-[0.1em]`}>Contact</p>
          <a href="mailto:info@victoriavenezuelafoundation.org" class="inline-flex min-h-11 items-center font-sans text-size-sm leading-body text-brand-accent md:min-h-0">
            info@victoriavenezuelafoundation.org
          </a>
          <a href="tel:+19543710557" class="inline-flex min-h-11 items-center font-sans text-size-sm leading-body text-brand-accent md:min-h-0">+1 (954) 371-0557</a>
        </div>
        <ul class="flex gap-3">
          {
            socialLinks.map((s) => (
              <li>
                <a href={s.href} class="flex h-11 w-11 items-center py-1.5 pr-1.5">
                  <img src={s.icon} alt={s.label} width="24" height="24" loading="lazy" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <hr class="border-0 border-t border-neutral-light-gray" />
    <div class="flex flex-col items-start gap-3 md:flex-row md:flex-wrap md:items-start md:justify-between">
        <div class="flex flex-col gap-3 md:gap-6">
          <p class={credit}>Designed and Developed by <a href="https://www.paulainc.ca/" class="text-brand-accent">Paula Inc.</a></p>
          <p class={credit}>© {new Date().getFullYear()} Victoria Venezuela Foundation. All rights reserved.</p>
        </div>
        <a href="/privacy-policy" class={link}>Privacy policy</a>
    </div>
  </div>
</footer>
