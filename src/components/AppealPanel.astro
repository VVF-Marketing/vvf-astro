---
// Live counterpart: `.section_appeal-ways` / event `.appeal-golf_section` —
// navy panel (radius 2xl) with the earthquake appeal: heading, copy, a large
// render with caption, the AppealCards triad and two actions.
import AppealCards, { type AppealCard } from './AppealCards.astro'
import Button from './Button.astro'

export interface Props {
  heading: string
  text?: string
  imageUrl?: string
  imageAlt?: string
  caption?: string
  cardsLabel?: string
  cards: AppealCard[]
  primaryCta?: { label: string; href: string }
  secondaryCta?: { label: string; href: string }
}

const { heading, text, imageUrl, imageAlt = '', caption, cardsLabel, cards, primaryCta, secondaryCta } = Astro.props as Props
---

<section class="px-0 sm:px-6 md:px-16">
  <div class="mx-auto flex max-w-screen-xl flex-col gap-16 rounded-xl bg-brand-primary px-6 py-16 md:rounded-2xl md:px-10">
    <div class="mx-auto flex max-w-[880px] flex-col gap-6 text-center">
      <h2 class="text-h2-mobile leading-[1.1] text-neutral-white md:text-h2">{heading}</h2>
      {text && <p class="font-body text-size-md leading-body text-neutral-white">{text}</p>}
    </div>
    {
      imageUrl && (
        <figure class="flex flex-col gap-6">
          <img src={imageUrl} alt={imageAlt} class="aspect-[2/1] w-full rounded-2xl object-cover" loading="lazy" />
          {caption && <figcaption class="text-center font-body text-size-sm leading-body text-neutral-white">{caption}</figcaption>}
        </figure>
      )
    }
    <AppealCards label={cardsLabel} cards={cards} />
    {
      (primaryCta || secondaryCta) && (
        <div class="flex flex-wrap justify-center gap-4">
          {primaryCta && <Button href={primaryCta.href} variant="primary">{primaryCta.label}</Button>}
          {secondaryCta && <Button href={secondaryCta.href} variant="outline">{secondaryCta.label}</Button>}
        </div>
      )
    }
  </div>
</section>
