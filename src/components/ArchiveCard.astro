---
// A card in the Events & Campaigns archive (spec 7.7, section 4): photo with
// a "Concluded" band, an EVENT or CAMPAIGN tag, the title and "See
// highlights". The whole card is the link (spec 5.6). `wide` shows the
// summary too (a single card in the archive).
import Button from './Button.astro'

export interface Props {
  href?: string
  imageUrl?: string
  imageAlt?: string
  tag: string
  title: string
  summary?: string
  concludedLabel: string
  buttonLabel: string
  wide?: boolean
}

const { href, imageUrl, imageAlt = '', tag, title, summary, concludedLabel, buttonLabel, wide = false } = Astro.props as Props
const Tag = href ? 'a' : 'div'
---

<Tag href={href} class={`flex h-full flex-col overflow-hidden rounded-card bg-neutral-white no-underline transition-shadow hover:shadow-hover ${wide ? 'md:flex-row' : ''}`}>
  <div class={`relative ${wide ? 'md:w-1/2' : ''}`}>
    {imageUrl && <img src={imageUrl} alt={imageAlt} class="aspect-[3/2] h-full w-full object-cover" loading="lazy" draggable="false" />}
    <p class="absolute inset-x-0 bottom-0 bg-brand-primary/80 py-2 text-center font-label text-size-sm font-semibold uppercase tracking-[0.1em] text-neutral-white">{concludedLabel}</p>
  </div>
  <div class={`flex flex-1 flex-col items-start gap-4 p-6 ${wide ? 'md:justify-center md:p-10' : ''}`}>
    <p class="font-label text-size-xs font-bold uppercase tracking-[0.12em] text-brand-accent">{tag}</p>
    <h3 class="text-h4 text-brand-primary">{title}</h3>
    {wide && summary && <p class="font-body text-size-md leading-body text-brand-primary">{summary}</p>}
    <Button variant="outline" as="span" class="mt-auto">{buttonLabel}</Button>
  </div>
</Tag>
