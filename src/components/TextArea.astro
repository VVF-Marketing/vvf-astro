---
// Live counterpart: `.textarea` — 20px-radius box with the same navy
// hairline border as text fields.
export interface Props {
  label?: string
  id?: string
  class?: string
  [key: string]: any
}

const { label, id = label ? `field-${Math.random().toString(36).slice(2, 8)}` : undefined, class: className = '', ...rest } = Astro.props as Props
const area = `block min-h-[180px] w-full rounded-[20px] border border-brand-primary bg-transparent p-3 font-body text-size-sm leading-5 text-brand-primary placeholder:text-brand-primary/50 ${className}`
---

{
  label ? (
    <div class="flex flex-col">
      <label for={id} class="mb-1 font-body text-size-sm font-medium leading-body text-brand-primary">{label}</label>
      <textarea id={id} class={area} {...rest}></textarea>
    </div>
  ) : (
    <textarea id={id} class={area} {...rest}></textarea>
  )
}
