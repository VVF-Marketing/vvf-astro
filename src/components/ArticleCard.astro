---
// Live counterpart: `.article-card_component` on the Resources pages.
//   featured  wide card, photo left, date/title/excerpt + "Read on" right
//   grid      white card (radius 2xl) with a rounded photo, date, title, excerpt
//   related   compact row: square image left, category tag + title right
// A press card (an article on another website, spec 7.12) links to the
// outlet and reads "Read on {outlet} ↗"; external links open in a new tab
// site-wide (src/lib/externalLinks.ts).
import Badge from './Badge.astro'
import Button from './Button.astro'
import { fill, getGlobalCopy } from '../lib/globalCopy'
import { LANG_TAGS, localeFromPath } from '../lib/i18n'

const t = await getGlobalCopy(Astro)
const locale = localeFromPath(Astro.originPathname)

export interface Props {
  href: string
  title: string
  date?: string
  excerpt?: string
  imageUrl?: string
  imageAlt?: string
  category?: string
  variant?: 'featured' | 'grid' | 'related'
  // Press card: the outlet's name, and the article's language when set.
  outlet?: string
  languageTag?: string
}

const { href, title, date, excerpt, imageUrl, imageAlt = '', category, variant = 'grid', outlet, languageTag } = Astro.props as Props
const dateLabel = date
  ? new Date(date).toLocaleDateString(LANG_TAGS[locale], { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : undefined
const dateClass = 'font-label text-size-sm font-semibold leading-body tracking-[0.1em] text-brand-primary'
---

{
  variant === 'featured' ? (
    <a href={href} class="flex flex-col overflow-hidden rounded-card bg-neutral-white no-underline transition-shadow hover:shadow-hover md:flex-row md:items-center">
      {imageUrl && <img src={imageUrl} alt={imageAlt} class="aspect-[4/3] w-full rounded-[20px] object-cover md:w-[43.7%]" />}
      <div class="flex flex-1 flex-col items-start gap-4 px-6 py-8 md:px-10">
        {dateLabel && <p class={dateClass}>{dateLabel}</p>}
        <h3 class="text-h3-mobile text-brand-primary md:text-h3">{title}</h3>
        {excerpt && <p class="font-body text-size-md leading-body text-brand-primary">{excerpt}</p>}
        <Button variant="outline" class="pointer-events-none" tabindex="-1" aria-hidden="true">
          {t['card.readOn']}
        </Button>
      </div>
    </a>
  ) : variant === 'related' ? (
    <a href={href} class="flex overflow-hidden rounded-card bg-neutral-white no-underline transition-shadow hover:shadow-hover">
      {imageUrl && <img src={imageUrl} alt={imageAlt} class="aspect-square w-[112px] shrink-0 object-cover sm:w-[162px]" loading="lazy" />}
      <!-- Phones: a narrower photo, and long words wrap (Spanish titles). -->
      <div class="flex min-w-0 flex-col items-start justify-center gap-3 p-5 sm:p-8">
        {category && <Badge>{category}</Badge>}
        <h3 class="hyphens-auto break-words text-h4 text-brand-primary">{title}</h3>
      </div>
    </a>
  ) : (
    <a href={href} class="flex flex-col gap-6 rounded-card bg-neutral-white p-6 no-underline transition-shadow hover:shadow-hover">
      {imageUrl && <img src={imageUrl} alt={imageAlt} class="aspect-[345/242] w-full rounded-[24px] object-cover" loading="lazy" />}
      <div class="flex flex-col gap-4 px-2 pb-2">
        <div class="flex flex-wrap items-center gap-3">
          {dateLabel && <p class={dateClass}>{dateLabel}</p>}
          {category && <Badge>{category}</Badge>}
          {languageTag && <Badge>{languageTag}</Badge>}
        </div>
        <div class="flex flex-col gap-2">
          <h3 class="text-h4 text-brand-primary">{title}</h3>
          {excerpt && <p class="font-body text-size-md leading-body text-brand-primary">{excerpt}</p>}
        </div>
        {outlet && <p class="font-sans text-size-md font-bold text-brand-accent">{fill(t['card.readOnOutlet'], { outlet })}</p>}
      </div>
    </a>
  )
}
