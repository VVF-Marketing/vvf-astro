---
// Live counterpart: home `.section_content-image` ("Build a bond that
// matters") — inset navy panel (radius 2xl) with tagline, white heading,
// copy, bullet list and a primary button beside a rounded photo.
import type { CtaLink } from './Hero.astro'
import Button from './Button.astro'
import Eyebrow from './Eyebrow.astro'

export interface Props {
  eyebrow?: string
  heading: string
  body?: string
  bullets?: string[]
  imageUrl?: string
  imageAlt?: string
  cta?: CtaLink
  // Our Team volunteers panel: short titled points in pastel text colors.
  highlights?: { title: string; text: string; tone: 'sun' | 'sky' }[]
  ctaVariant?: 'primary' | 'primary-inverse'
}

const { eyebrow, heading, body, bullets, imageUrl, imageAlt = '', cta, highlights, ctaVariant = 'primary' } = Astro.props as Props
const highlightTones = { sun: 'text-sun', sky: 'text-sky' }
---

<section class="mx-0 rounded-xl bg-brand-primary px-6 py-10 text-neutral-white sm:mx-6 md:rounded-2xl md:px-10 md:py-16">
  <div class="mx-auto flex max-w-screen-xl flex-col-reverse gap-10 lg:flex-row lg:items-center lg:gap-20">
    <div class="flex flex-1 flex-col items-center text-center lg:items-start lg:text-left">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <h2 class="my-4 text-h2-mobile leading-[1.1] text-neutral-white md:text-h2">{heading}</h2>
      {body && <p class="font-sans text-size-md leading-body text-neutral-white">{body}</p>}
      {
        bullets && bullets.length > 0 && (
          <ul class="mt-12 flex list-disc flex-col gap-4 pl-5 text-left">
            {bullets.map((b) => (
              <li class="font-sans text-size-md leading-body text-neutral-white">{b}</li>
            ))}
          </ul>
        )
      }
      {
        highlights && highlights.length > 0 && (
          <ul class="mt-16 flex w-full max-w-[500px] flex-col divide-y divide-sun">
            {highlights.map((h) => (
              <li class={`flex flex-col gap-4 px-6 py-6 ${highlightTones[h.tone]}`}>
                <h3 class="font-sans text-h5 font-extrabold leading-[1.4]">{h.title}</h3>
                <p class="font-sans text-size-md leading-body">{h.text}</p>
              </li>
            ))}
          </ul>
        )
      }
      {
        cta && (
          <Button href={cta.href} variant={ctaVariant} class="mt-12">
            {cta.label}
          </Button>
        )
      }
    </div>
    {imageUrl && <img src={imageUrl} alt={imageAlt} class="aspect-[592/631] w-full rounded-2xl object-cover lg:w-[46%]" loading="lazy" />}
  </div>
</section>
