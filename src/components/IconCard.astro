---
// Live counterpart: Sponsor a Child `.sponsor-rewards_card` — white card
// (24px radius) with a centered icon area, bold title and short copy.
export interface Props {
  iconUrl?: string
  title: string
  text?: string
  tone?: 'white' | 'sun' | 'salmon' | 'sky'
}

const { iconUrl, title, text, tone = 'white' } = Astro.props as Props
const tones = { white: 'bg-neutral-white', sun: 'bg-sun', salmon: 'bg-salmon', sky: 'bg-sky' }
---

<article class={`flex h-full flex-col rounded-[24px] ${tones[tone]}`}>
  {
    iconUrl && (
      <div class="flex h-[170px] items-center justify-center p-10">
        <img src={iconUrl} alt="" class="h-full w-auto" loading="lazy" />
      </div>
    )
  }
  <div class="flex flex-col gap-4 px-8 pb-8 pt-6">
    <h3 class="text-h5 leading-[1.4] text-brand-primary">{title}</h3>
    {text && <p class="font-body text-size-sm leading-body text-brand-primary">{text}</p>}
  </div>
</article>
