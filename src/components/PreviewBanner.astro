---
// A strip above everything on preview deployments only (src/lib/previewBanner.ts).
import { PREVIEW_BANNER_TEXT, showPreviewBanner } from '../lib/previewBanner'

export interface Props {
  env?: string
}

const { env } = Astro.props as Props
---

{
  showPreviewBanner(env) && (
    <div data-preview-banner class="bg-brand-primary px-6 py-2 text-center font-sans text-size-sm font-bold text-white">
      {PREVIEW_BANNER_TEXT}
    </div>
  )
}
