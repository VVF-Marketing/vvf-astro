---
// Long-form copy (legal pages, resource bodies) styled like the live
// `.w-richtext` blocks: Open Sans 18px paragraphs, Nunito headings, disc
// lists, cyan links, table source notes. Pass sanitized HTML via `html`, or children via slot.
export interface Props {
  html?: string
  class?: string
}

const { html, class: className = '' } = Astro.props as Props
const prose = [
  'font-body text-size-md leading-body text-brand-primary',
  '[&_p]:mb-6 [&_p]:text-size-md',
  '[&_h2]:mb-6 [&_h2]:mt-12 [&_h2]:text-h5 [&_h2]:font-extrabold [&_h2]:leading-[1.3] md:[&_h2]:text-[1.5rem]',
  '[&_h3]:mb-4 [&_h3]:mt-10 [&_h3]:text-h5 [&_h3]:leading-[1.3]',
  '[&_h4]:mb-4 [&_h4]:mt-8 [&_h4]:text-size-lg [&_h4]:leading-[1.3]',
  '[&_ul]:mb-6 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:mb-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mb-1',
  '[&_a]:text-link [&_a]:underline [&_strong]:font-bold',
  '[&_blockquote]:my-8 [&_blockquote]:rounded-2xl [&_blockquote]:border-0 [&_blockquote]:bg-sky [&_blockquote]:p-8 [&_blockquote]:text-size-lg',
  '[&_img]:my-8 [&_img]:rounded-2xl',
  // Tables render through ContentTable.astro; a paragraph right after one is
  // its source note (live `.article_body table + p`).
  '[&_.content-table+p]:text-size-sm [&_.content-table+p]:text-table-note',
].join(' ')
---

{html ? <div class={`${prose} ${className}`} set:html={html} /> : <div class={`${prose} ${className}`}><slot /></div>}
