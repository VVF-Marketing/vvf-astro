---
// Project-only (no live counterpart): site-wide campaign strip above the
// header, driven by EmDash campaign settings. Uses the live accent/navy
// pairing of the primary button.
import { getGlobalCopy } from '../lib/globalCopy'

const t = await getGlobalCopy(Astro)
export interface Props {
  active: boolean
  text?: string
  href?: string
}

const { active, text, href = '/earthquake-relief' } = Astro.props as Props
---

{
  active && (
    <div class="bg-brand-accent">
      <a
        href={href}
        class="mx-auto flex max-w-screen-xl items-center justify-center gap-2 px-6 py-2 font-sans text-size-sm text-brand-primary no-underline hover:underline"
      >
        <span>{text ?? t['banner.text']}</span>
        <span class="font-bold">{t['banner.cta']}</span>
      </a>
    </div>
  )
}
