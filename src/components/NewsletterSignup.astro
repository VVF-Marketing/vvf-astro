---
// Live counterpart: Resources "Stay connected" box — sky card (radius 2xl)
// with heading, intro, pill email field, Subscribe button and privacy note.
import Button from './Button.astro'
import { getGlobalCopy } from '../lib/globalCopy'

const t = await getGlobalCopy(Astro)

export interface Props {
  heading?: string
  text?: string
  // `wide`: full-width panel with the field capped at 520px (Events page).
  width?: 'narrow' | 'wide'
}

const { heading = t['newsletter.heading'], text = t['newsletter.text'], width = 'narrow' } = Astro.props as Props
// The result of the last send (?form=sent|invalid|unavailable, /api/forms).
const result = ['sent', 'invalid', 'unavailable'].find((r) => r === Astro.url.searchParams.get('form'))
---

<div id="newsletter" class="flex scroll-mt-8 flex-col items-center gap-6 rounded-2xl bg-sky p-10 text-center md:p-16">
  <h2 class={`leading-[1.16] tracking-[-0.01em] text-brand-primary ${width === 'wide' ? 'text-h2-mobile md:text-h2' : 'text-[2.25rem]'}`}>{heading}</h2>
  <p class="font-body text-size-md leading-body text-brand-primary">{text}</p>
  <!-- A normal HTML form post (spec 8.4) carrying the page it was sent from. -->
  <form
    method="post"
    action="/api/forms/newsletter"
    class={`mt-8 flex w-full flex-col items-center gap-4 ${width === 'wide' ? 'max-w-[520px]' : ''}`}
    data-newsletter-form
    data-msg-required={t['form.required']}
    data-msg-email={t['form.email']}
  >
    <input type="hidden" name="page" value={Astro.originPathname.replace(/\/$/, '') || '/'} />
    <!-- Honeypot (src/lib/forms.ts): off screen and out of the tab order; only bots fill it in. -->
    <div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden"><input type="text" name="website" tabindex="-1" autocomplete="off" /></div>
    {
      result && (
        <p role="status" class="font-label text-size-sm font-semibold text-brand-primary" data-form-result={result}>
          {result === 'sent' ? t['newsletter.sent'] : result === 'invalid' ? t['form.invalid'] : t['form.unavailable']}
        </p>
      )
    }
    <label class="sr-only" for="newsletter-email">{t['newsletter.emailLabel']}</label>
    <input
      id="newsletter-email"
      type="email"
      name="email"
      required
      placeholder={t['newsletter.placeholder']}
      autocomplete="email"
      class="h-[51px] w-full rounded-pill border border-brand-primary bg-transparent px-6 py-3 text-center font-body text-size-md text-brand-primary placeholder:text-brand-primary/50"
    />
    <Button type="submit" variant="primary-inverse">{t['newsletter.submit']}</Button>
  </form>
  <p class="mt-8 font-sans text-size-sm leading-body text-brand-primary">{t['newsletter.privacy']}</p>
</div>

<script>
  import { localizeValidation } from '../lib/formValidation'

  document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach(localizeValidation)
</script>
