---
// Live counterpart: `.event-card_component` — white card (radius 20px) with
// the photo on the left and date tag, title, location, intro and an outline
// "See the details" button on the right; stacks and centers on mobile.
import type { EventItem } from '../lib/content/types'
import Button from './Button.astro'
import Badge from './Badge.astro'
import { getGlobalCopy } from '../lib/globalCopy'
import { LANG_TAGS, localeFromPath } from '../lib/i18n'

const t = await getGlobalCopy(Astro)
const locale = localeFromPath(Astro.originPathname)

export interface Props {
  event: EventItem
  // `compact`: live past-event card (`.events-past_item`) — narrow photo,
  // half-width card.
  variant?: 'default' | 'compact'
  ctaLabel?: string
}

const { event, variant = 'default', ctaLabel = t['card.eventDetails'] } = Astro.props as Props
const compact = variant === 'compact'
const dateLabel = new Date(event.startDate).toLocaleDateString(LANG_TAGS[locale], {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
})
---

<!-- The whole card is one link, with no link inside it (spec 5.6). -->
<a href={`/events/${event.slug}`} class={`flex flex-col overflow-hidden rounded-card bg-neutral-white no-underline transition-shadow hover:shadow-hover md:flex-row md:items-stretch ${compact ? 'md:max-w-[624px]' : ''}`}>
  {
    event.imageUrl && (
      <picture class={`contents`}>
        {/* The phone photo, when set (spec 7.7, phones). A card photo is
            cropped for the card at every width, so it replaces both. */}
        {!event.cardImageUrl && event.heroImageMobileUrl && <source media="(max-width: 767px)" srcset={event.heroImageMobileUrl} />}
        <img
          src={event.cardImageUrl ?? event.imageUrl}
          alt=""
          class={`h-[183px] w-full object-cover md:h-auto ${compact ? 'md:min-h-[328px] md:w-[207px]' : 'md:min-h-[300px] md:w-[53.3%]'}`}
          loading="lazy"
          draggable="false"
        />
      </picture>
    )
  }
  <div class="flex flex-1 flex-col items-center justify-center gap-3 p-5 text-center md:items-start md:gap-8 md:px-10 md:py-8 md:text-left">
    <div class="flex flex-col items-center gap-4 md:items-start">
      <Badge>{dateLabel}</Badge>
      <div class="flex flex-col items-center gap-0 md:items-start">
        <h3 class="text-h4 text-brand-primary">{event.title}</h3>
        {event.location && <p class="font-sans text-size-sm leading-body text-brand-primary">{event.location}</p>}
        {event.description && <p class="font-sans text-size-md leading-body text-brand-primary">{event.description}</p>}
      </div>
    </div>
    <Button variant="outline" as="span">{ctaLabel}</Button>
  </div>
</a>
