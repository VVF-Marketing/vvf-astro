---
// Rich-text table (Portable Text `table` blocks in CMS bodies), styled like
// the live `.article_body` tables: white rounded card, light border, sky
// header row, dividers between rows, semibold first column. Replaces
// EmDash's own Table.astro (see PortableBody.astro); the layout comes from
// src/lib/contentTable.ts. Formatting set in the editor wins over the
// defaults: cell alignment is inline, column widths are a <colgroup>.
import { PortableText } from 'astro-portabletext'
import { emdashComponents } from 'emdash/ui'
import { layoutContentTable, type LaidOutCell } from '../lib/contentTable'

export interface Props {
  node: unknown
}

const layout = layoutContentTable(Astro.props.node)
const marks = { mark: emdashComponents.mark }
const attrs = (c: LaidOutCell) => ({
  scope: c.scope,
  colspan: c.colspan,
  rowspan: c.rowspan,
  style: c.textAlign ? `text-align: ${c.textAlign};` : undefined,
})
---

<div class="content-table">
  <table style={`min-width: ${layout.minWidth}px;`}>
    {
      layout.ok ? (
        <>
          {layout.columnWidths && (
            <colgroup>
              {layout.columnWidths.map((w) => (
                <col style={`width: ${w}px;`} />
              ))}
            </colgroup>
          )}
          {layout.headerRow && (
            <thead>
              <tr>
                {layout.headerRow.map((c) => (
                  <th {...attrs(c)}>
                    <PortableText value={[c.block]} components={marks} />
                  </th>
                ))}
              </tr>
            </thead>
          )}
          <tbody>
            {layout.bodyRows.map((row) => (
              <tr>
                {row.map((c) => {
                  const Cell = c.header ? 'th' : 'td'
                  return (
                    <Cell {...attrs(c)}>
                      <PortableText value={[c.block]} components={marks} />
                    </Cell>
                  )
                })}
              </tr>
            ))}
          </tbody>
        </>
      ) : (
        <tbody>
          {layout.rawRows.map((row) => (
            <tr>
              {row.map((text) => (
                <td>{text}</td>
              ))}
            </tr>
          ))}
        </tbody>
      )
    }
  </table>
</div>

<style>
  /* The live card sits on the table (overflow: hidden); here it sits on the
     wrapper so a table wider than the screen scrolls inside the card. */
  .content-table {
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    margin: 0 0 27px;
    border: 1px solid var(--table-border);
    border-radius: 16px;
    background: var(--base-color-branding--neutral-white);
  }
  table {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 16px;
    /* Live cells inherit the article body's 27px (18px × 1.5) at every size. */
    line-height: 27px;
  }
  th,
  td {
    padding: 12px 16px;
    text-align: left;
    vertical-align: top;
    border-top: 1px solid var(--table-border);
    overflow-wrap: anywhere;
    font-weight: 400;
  }
  thead th {
    background: var(--base-color-system--sky);
    border-top: 0;
    font-weight: 600;
  }
  /* No header row: the first row has no divider above it. */
  table:not(:has(thead)) tbody tr:first-child > * {
    border-top: 0;
  }
  td:first-child,
  th[scope='row'] {
    font-weight: 600;
  }
  /* Cell text renders as a paragraph; keep it table-sized (the surrounding
     RichText styles body paragraphs). */
  th :global(p),
  td :global(p) {
    margin: 0;
    font-size: inherit;
  }
  @media (max-width: 479px) {
    table {
      font-size: 14px;
    }
    th,
    td {
      padding: 10px 8px;
    }
  }
</style>
