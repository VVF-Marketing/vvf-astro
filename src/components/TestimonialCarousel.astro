---
import Button from './Button.astro'
import Card from './Card.astro'
import { getGlobalCopy } from '../lib/globalCopy'

const t = await getGlobalCopy(Astro)

export interface TestimonialItem {
  title: string
  body?: string
}

export interface Props {
  items: TestimonialItem[]
}

const { items } = Astro.props as Props
---

<div data-testimonial-carousel>
  <div class="flex items-center gap-3">
    <Button variant="icon" data-prev aria-label={t['a11y.prevStory']}>‹</Button>
    <div class="flex-1 flex gap-4 overflow-x-hidden scroll-smooth" data-track>
      {
        items.map((item) => (
          <Card class="w-full shrink-0 p-8 sm:w-[320px]">
            <p class="text-h5 leading-[1.4] text-brand-primary">{item.title}</p>
            {item.body && <p class="mt-2 font-body text-size-base leading-body text-brand-primary">{item.body}</p>}
          </Card>
        ))
      }
    </div>
    <Button variant="icon" data-next aria-label={t['a11y.nextStory']}>›</Button>
  </div>
  <div class="mt-4 flex justify-center gap-2" data-dots>
    {items.map((_, i) => <span class="h-2 w-2 rounded-full bg-neutral-light-gray" data-dot={i} />)}
  </div>
</div>

<script>
  import { nextScrollLeft, prevScrollLeft } from '../lib/carousel'

  document.querySelectorAll<HTMLElement>('[data-testimonial-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')
    const next = root.querySelector<HTMLElement>('[data-next]')
    const prev = root.querySelector<HTMLElement>('[data-prev]')
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'))
    if (!track) return
    const step = 340

    function syncDots() {
      const max = track!.scrollWidth - track!.clientWidth
      const progress = max > 0 ? track!.scrollLeft / max : 0
      const activeIndex = Math.round(progress * (dots.length - 1))
      dots.forEach((dot, i) => dot.classList.toggle('bg-brand-accent', i === activeIndex))
    }

    next?.addEventListener('click', () => {
      const max = track.scrollWidth - track.clientWidth
      track.scrollLeft = nextScrollLeft(track.scrollLeft, max, step)
      syncDots()
    })
    prev?.addEventListener('click', () => {
      const max = track.scrollWidth - track.clientWidth
      track.scrollLeft = prevScrollLeft(track.scrollLeft, max, step)
      syncDots()
    })
    syncDots()
  })
</script>
