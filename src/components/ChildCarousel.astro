---
// Live counterpart: Sponsor a Child "Meet the children" strip
// (`.sponsor-children_list`). Spec 7.2, section 3: arrows from 768px up,
// dots below, mouse drag, no scrollbar; a drag never opens a profile.
import type { ChildItem } from '../lib/content/types'
import ChildCard from './ChildCard.astro'
import SwipeDots from './SwipeDots.astro'
import { getGlobalCopy } from '../lib/globalCopy'

const t = await getGlobalCopy(Astro)

export interface Props {
  items: Pick<ChildItem, 'slug' | 'displayName' | 'age' | 'imageUrl'>[]
}

const { items } = Astro.props as Props
const arrow =
  'absolute top-[115px] hidden h-[70px] w-[70px] -translate-y-1/2 items-center justify-center rounded-full border-2 border-brand-accent bg-neutral-white text-brand-primary md:flex'
---

<div class="relative" data-child-carousel data-swipe>
  <ul class="flex snap-x scroll-px-6 gap-6 overflow-x-auto scroll-smooth px-6 pb-2 [scrollbar-width:none] md:scroll-px-16 md:px-16 [&::-webkit-scrollbar]:hidden" data-track>
    {
      items.map((child) => (
        <li class="w-[231px] shrink-0 snap-start">
          <ChildCard child={child} variant="compact" />
        </li>
      ))
    }
  </ul>
  <button type="button" class={`${arrow} left-7`} aria-label={t['child.carouselPrev']} data-prev>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <button type="button" class={`${arrow} right-7`} aria-label={t['child.carouselLabel']} data-next>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <SwipeDots count={items.length} class="mt-6 flex-wrap px-6 md:hidden" />
</div>

<script>
  import { nextScrollLeft, prevScrollLeft } from '../lib/carousel'
  import { initSwipes } from '../lib/swipe'

  initSwipes()
  document.querySelectorAll<HTMLElement>('[data-child-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')
    if (!track) return
    const max = () => track.scrollWidth - track.clientWidth
    root.querySelector('[data-next]')?.addEventListener('click', () => {
      track.scrollLeft = nextScrollLeft(track.scrollLeft, max(), 255)
    })
    root.querySelector('[data-prev]')?.addEventListener('click', () => {
      track.scrollLeft = prevScrollLeft(track.scrollLeft, max(), 255)
    })
  })
</script>
