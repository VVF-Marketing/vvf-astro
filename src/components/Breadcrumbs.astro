---
// Live counterpart: `.crumbs_list` — small uppercase Open Sans trail, links
// in the accent color, "›" separators, current page in navy. Emits the same
// trail as a schema.org BreadcrumbList.
import { getGlobalCopy } from '../lib/globalCopy'
import { localeFromPath } from '../lib/i18n'
import { breadcrumbList, serialize } from '../lib/structuredData'

const t = await getGlobalCopy(Astro)
export interface Crumb {
  label: string
  href?: string
}

export interface Props {
  items: Crumb[]
  // `light` for use on dark/photo backgrounds (live w-variant).
  tone?: 'default' | 'light'
  class?: string
}

const { items, tone = 'default', class: className = '' } = Astro.props as Props
const site = Astro.site ?? Astro.url
const jsonLd = breadcrumbList(items, site, localeFromPath(Astro.originPathname), new URL(Astro.originPathname, site).href)
// Blue links: `blue` on dark backgrounds, `blue-text` on light ones (Q13).
const link = tone === 'light' ? 'text-brand-accent' : 'text-brand-accent-text'
const current = tone === 'light' ? 'text-neutral-white' : 'text-brand-primary'
const sep = tone === 'light' ? 'text-neutral-white opacity-85' : 'text-brand-primary opacity-45'
const text = 'font-body text-[13px] font-semibold uppercase leading-body no-underline'
---

<nav aria-label={t['a11y.breadcrumb']} class={className}>
  <ol class="m-0 flex list-none flex-wrap items-center gap-x-2.5 gap-y-1.5 p-0">
    {
      items.map((item, i) => {
        const isLast = i === items.length - 1
        return (
          <li class="flex min-w-0 items-center gap-2.5">
            {i > 0 && (
              <span class={`font-body text-[17px] leading-none ${sep}`} aria-hidden="true">
                ›
              </span>
            )}
            {isLast || !item.href ? (
              <span class={`${text} min-w-0 ${current}`} aria-current={isLast ? 'page' : undefined}>
                {item.label}
              </span>
            ) : (
              <a href={item.href} class={`${text} ${link}`}>
                {item.label}
              </a>
            )}
          </li>
        )
      })
    }
  </ol>
</nav>
{jsonLd && <script type="application/ld+json" set:html={serialize(jsonLd)} />}
