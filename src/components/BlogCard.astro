---
import type { PostItem } from '../lib/content/types'
import ArticleCard from './ArticleCard.astro'

export interface Props {
  post: PostItem
}

const { post } = Astro.props as Props
---

<!-- Project blog card; styled as the live Resources article card. -->
<ArticleCard href={`/blog/${post.slug}`} title={post.title} date={post.publishedAt} excerpt={post.excerpt} imageUrl={post.imageUrl} />
