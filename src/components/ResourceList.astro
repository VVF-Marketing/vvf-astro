---
// Resources and its category pages share this layout (spec 7.12): header,
// the featured article, filter buttons, a grid of six articles a page
// (`?page=2`) leaving out the featured one, and a sidebar with the
// newsletter and three Related articles. Press articles (on other websites)
// link to the outlet and never appear in Related.
import type { ResourceCategory, ResourceItem } from '../lib/content/types'
import { RESOURCE_CATEGORIES, RESOURCE_CATEGORY_PATHS, resourceTag } from '../lib/content/types'
import ArticleCard from './ArticleCard.astro'
import Breadcrumbs from './Breadcrumbs.astro'
import NewsletterSignup from './NewsletterSignup.astro'
import Pagination from './Pagination.astro'
import { getGlobalCopy } from '../lib/globalCopy'
import { paginate } from '../lib/pagination'

const t = await getGlobalCopy(Astro)

const PER_PAGE = 6

export interface Props {
  // The page's articles, newest first: every article, or one category's.
  resources: ResourceItem[]
  category?: ResourceCategory
  // Category pages: the category's name and description.
  heading?: string
  description?: string
}

const { resources, category, heading = t['resources.heading'], description } = Astro.props as Props
const featured = resources.find((r) => r.featured && !r.external)
const listed = resources.filter((r) => r !== featured)
const { items, page, pages } = paginate(listed, Astro.url.searchParams.get('page'), PER_PAGE)
const related = resources.filter((r) => r !== featured && !r.external).slice(0, 3)
const listUrl = new URL(Astro.originPathname + Astro.url.search, Astro.url)

const pill = 'inline-flex items-center rounded-pill border-2 border-brand-accent px-6 py-2 font-sans text-size-md font-bold no-underline'
const categoryLabels: Record<ResourceCategory, string> = {
  stories: t['resources.category.stories'],
  'financials-transparency': t['resources.category.financials'],
}
const filters = [{ label: t['resources.viewAll'], href: '/resources', active: !category }].concat(
  RESOURCE_CATEGORIES.map((c) => ({ label: categoryLabels[c], href: `/resources/${RESOURCE_CATEGORY_PATHS[c]}`, active: c === category }))
)
const tag = (r: ResourceItem) => resourceTag(r, categoryLabels)
const card = (r: ResourceItem) =>
  r.external && r.externalUrl
    ? { href: r.externalUrl, outlet: r.outlet ?? new URL(r.externalUrl).hostname, languageTag: r.languageTag }
    : { href: `/resources/${r.slug}` }
---

<section class="px-6 pb-16 md:pb-[120px] pt-16 md:pt-16 md:px-16">
  <div class="mx-auto max-w-[1312px]">
    {category && <Breadcrumbs items={[{ label: t['resources.breadcrumb'], href: '/resources' }, { label: heading }]} />}
    <h1 class="mt-6 text-center text-h2-mobile leading-[1.1] text-brand-primary md:text-h2">{heading}</h1>
    {description && <p class="mx-auto mt-4 max-w-3xl text-center font-body text-size-md leading-body text-brand-primary">{description}</p>}
    {
      featured && (
        <div class="mt-12">
          <ArticleCard
            variant="featured"
            href={`/resources/${featured.slug}`}
            title={featured.title}
            date={featured.publishedAt}
            excerpt={featured.excerpt}
            imageUrl={featured.imageUrl}
            imageAlt={featured.imageAlt}
          />
        </div>
      )
    }
    <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_413px]">
      <div id="articles" class="scroll-mt-8">
        <nav aria-label={t['resources.filtersLabel']} class="flex flex-wrap justify-center gap-3">
          {
            filters.map((f) => (
              <a href={f.href} class={`${pill} ${f.active ? 'bg-brand-accent text-neutral-white' : 'bg-transparent text-brand-accent'}`} aria-current={f.active ? 'page' : undefined}>
                {f.label}
              </a>
            ))
          }
        </nav>
        <ul class="mt-6 grid gap-6 sm:grid-cols-2">
          {
            items.map((r) => (
              <li>
                <ArticleCard {...card(r)} title={r.title} date={r.publishedAt} excerpt={r.excerpt} imageUrl={r.imageUrl} imageAlt={r.imageAlt} category={tag(r)} />
              </li>
            ))
          }
        </ul>
        {
          resources.length === 0 && (
            <p class="mt-10 text-center font-body text-size-md text-brand-primary">
              {t['resources.empty']} <a href="/resources" class="font-bold text-brand-primary underline">{t['resources.viewAll']}</a>
            </p>
          )
        }
        <Pagination page={page} pages={pages} hash="#articles" url={listUrl} />
      </div>
      <aside class="flex flex-col gap-10">
        <NewsletterSignup />
        {
          related.length > 0 && (
            <div class="flex flex-col gap-6">
              <h2 class="text-h4 text-brand-primary">{t['resources.related']}</h2>
              {related.map((r) => (
                <ArticleCard variant="related" href={`/resources/${r.slug}`} title={r.title} imageUrl={r.imageUrl} imageAlt={r.imageAlt} category={tag(r)} />
              ))}
            </div>
          )
        }
      </aside>
    </div>
  </div>
</section>
