---
// Live counterpart: `.team-card_component` — square photo (radius md) with
// name and title below; links to the profile page when the person has one.
// With `openSeat`, renders the live navy "Board seat open" tile instead of
// a photo (`.team-card_open-seat`).
import type { TeamMemberItem } from '../lib/content/types'

export interface OpenSeat {
  kicker: string
  heading: string
  cta: string
  href: string
}

export interface Props {
  member: Pick<TeamMemberItem, 'name' | 'role' | 'imageUrl' | 'profileSlug'>
  openSeat?: OpenSeat
}

const { member, openSeat } = Astro.props as Props
const href = openSeat?.href ?? (member.profileSlug ? `/our-team/${member.profileSlug}` : undefined)
const Tag = href ? 'a' : 'div'
---

<Tag href={href} class="group flex flex-col gap-4 no-underline md:gap-6">
  {
    openSeat ? (
      <div class="flex aspect-square w-full flex-col justify-center gap-3.5 rounded-md bg-brand-primary p-4 md:p-7">
        <p class="font-body text-size-xs font-bold uppercase leading-[1.2] tracking-[0.12em] text-brand-accent">{openSeat.kicker}</p>
        <p class="font-sans text-h5 font-extrabold leading-[1.2] text-neutral-white md:text-[1.75rem]">{openSeat.heading}</p>
        <span class="self-start rounded-full border-2 border-neutral-white px-5 py-2.5 font-sans text-size-base font-bold leading-[1.2] text-neutral-white group-hover:bg-neutral-white group-hover:text-brand-primary">
          {openSeat.cta}
        </span>
      </div>
    ) : (
      <img src={member.imageUrl} alt={member.name} class="aspect-square w-full rounded-md bg-neutral-light-gray object-cover" loading="lazy" />
    )
  }
  <div>
    <h3 class="text-h5 leading-[1.4] text-brand-primary">{member.name}</h3>
    <p class="font-sans text-size-sm leading-body text-brand-primary">{member.role}</p>
  </div>
</Tag>
