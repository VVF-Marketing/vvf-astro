---
// Live counterpart: Ways to Give `.give_amounts` — pill amount choices
// ($50 preselected) driving the "Continue to payment" Donorbox link.
import Button from './Button.astro'

export interface Props {
  baseUrl: string
  amounts?: number[]
  defaultAmount?: number
  // Extra query string kept on every link (e.g. UTM tags).
  query?: string
  ctaLabel?: string
}

const { baseUrl, amounts = [25, 50, 100, 250], defaultAmount = 50, query = '', ctaLabel = 'Continue to payment' } = Astro.props as Props
const urlFor = (amount?: number) => {
  const params = [amount ? `amount=${amount}` : '', query].filter(Boolean).join('&')
  return params ? `${baseUrl}?${params}` : baseUrl
}
const pill =
  'flex h-[58px] min-w-[86px] items-center justify-center rounded-pill border-2 border-brand-primary px-5 font-sans text-size-lg font-bold text-brand-primary no-underline aria-[current=true]:border-brand-accent aria-[current=true]:bg-brand-accent aria-[current=true]:text-neutral-white'
---

<div class="flex flex-col items-start gap-8" data-gift-picker>
  <div class="grid w-full grid-cols-2 gap-3 md:flex md:w-auto md:flex-wrap" role="group" aria-label="Gift amount">
    {
      amounts.map((a) => (
        <a href={urlFor(a)} class={pill} aria-current={a === defaultAmount ? 'true' : undefined} data-amount>
          ${a}
        </a>
      ))
    }
    <a href={urlFor()} class={`${pill} col-span-2`} data-amount>Other</a>
  </div>
  <Button href={urlFor(defaultAmount)} variant="primary" data-gift-continue>{ctaLabel}</Button>
</div>

<script>
  // Picking an amount updates the Continue link instead of leaving the page.
  document.querySelectorAll<HTMLElement>('[data-gift-picker]').forEach((root) => {
    const options = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-amount]'))
    const cont = root.querySelector<HTMLAnchorElement>('[data-gift-continue]')
    options.forEach((option) =>
      option.addEventListener('click', (event) => {
        event.preventDefault()
        options.forEach((o) => o.removeAttribute('aria-current'))
        option.setAttribute('aria-current', 'true')
        if (cont) cont.href = option.href
      })
    )
  })
</script>
