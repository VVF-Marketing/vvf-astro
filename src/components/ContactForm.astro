---
import Button from './Button.astro'
import TextField from './TextField.astro'
import TextArea from './TextArea.astro'

export interface Props {
  defaultTopic?: string
}

const { defaultTopic } = Astro.props as Props

// Topics and order as on the live contact form.
const topics = [
  { value: 'general', label: 'General inquiry' },
  { value: 'donation-support', label: 'Donation support' },
  { value: 'child-sponsorship', label: 'Child sponsorship' },
  { value: 'media-press', label: 'Media and press' },
  { value: 'corporate-partnerships', label: 'Corporate partnership' },
  { value: 'events', label: 'Events' },
  { value: 'volunteering', label: 'Volunteering' },
  { value: 'other', label: 'Other' },
]
---

<!-- Live counterpart: the contact page `.form` (Webflow form). -->
<form class="flex flex-col gap-6" data-contact-form novalidate>
  <div class="grid gap-6 sm:grid-cols-2">
    <TextField required name="firstName" label="First Name" placeholder="First Name" autocomplete="given-name" />
    <TextField required name="lastName" label="Last Name" placeholder="Last Name" autocomplete="family-name" />
  </div>
  <div class="grid gap-6 sm:grid-cols-2">
    <TextField required type="email" name="email" label="Email" placeholder="Email" autocomplete="email" />
    <TextField type="tel" name="phone" label="Phone Number" placeholder="Phone Number" autocomplete="tel" />
  </div>

  <div class="flex flex-col">
    <label for="contact-topic" class="mb-1 font-body text-size-sm font-medium leading-body text-brand-primary">What is this about?</label>
    <select
      id="contact-topic"
      name="topic"
      class="block h-[38px] w-full rounded-pill border border-brand-primary bg-transparent px-5 py-2 font-sans text-size-sm text-brand-primary"
      data-topic-select
    >
      {
        topics.map((t) => (
          <option value={t.value} selected={t.value === defaultTopic}>
            {t.label}
          </option>
        ))
      }
    </select>
  </div>

  <TextArea name="message" required label="Message" rows={7} />

  <label class="flex items-center gap-2 font-body text-size-sm font-medium text-brand-primary">
    <input type="checkbox" required name="privacyConsent" data-privacy-checkbox />
    <span>I agree to the <a href="/privacy-policy" class="text-link underline">Privacy Policy</a></span>
  </label>

  <Button type="submit" variant="primary-inverse" class="w-full" data-submit disabled>Send Message</Button>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const checkbox = form.querySelector<HTMLInputElement>('[data-privacy-checkbox]')
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')
    if (!checkbox || !submit) return

    const sync = () => {
      submit.disabled = !checkbox.checked
    }
    checkbox.addEventListener('change', sync)
    sync()

    form.addEventListener('submit', (e) => {
      if (!checkbox.checked) {
        e.preventDefault()
      }
    })
  })
</script>
