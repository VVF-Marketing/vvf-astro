---
import Button from './Button.astro'
import TextField from './TextField.astro'
import TextArea from './TextArea.astro'
import { getGlobalCopy } from '../lib/globalCopy'
import { CONTACT_TOPICS } from '../lib/contactTopics'

const t = await getGlobalCopy(Astro)

export interface Props {
  defaultTopic?: string
}

const { defaultTopic } = Astro.props as Props
// The result of the last send (?form=sent|invalid|unavailable, /api/forms).
const result = ['sent', 'invalid', 'unavailable'].find((r) => r === Astro.url.searchParams.get('form'))

const topics = CONTACT_TOPICS.map((topic) => ({ value: topic.value, label: t[topic.key] }))
---

<!-- Live counterpart: the contact page `.form` (Webflow form). A normal HTML
     form post (spec 8.4) carrying the page it was sent from. -->
<form
  method="post"
  action="/api/forms/contact"
  class="flex flex-col gap-6"
  data-contact-form
  data-msg-required={t['form.required']}
  data-msg-email={t['form.email']}
  data-msg-topic={t['form.topic']}
  data-msg-consent={t['form.consent']}
>
  <input type="hidden" name="page" value={Astro.originPathname.replace(/\/$/, '') || '/'} />
  <!-- Honeypot (src/lib/forms.ts): off screen and out of the tab order; only bots fill it in. -->
  <div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden"><input type="text" name="website" tabindex="-1" autocomplete="off" /></div>
  {
    result && (
      <p role="status" class={`rounded-md px-5 py-4 font-label text-size-sm font-semibold text-brand-primary ${result === 'sent' ? 'bg-neutral-white' : 'bg-salmon'}`} data-form-result={result}>
        {result === 'sent' ? t['contactForm.sent'] : result === 'invalid' ? t['form.invalid'] : t['form.unavailable']}
      </p>
    )
  }
  <div class="grid gap-6 sm:grid-cols-2">
    <TextField required name="firstName" label={t['contactForm.firstName']} placeholder={t['contactForm.firstName']} autocomplete="given-name" />
    <TextField required name="lastName" label={t['contactForm.lastName']} placeholder={t['contactForm.lastName']} autocomplete="family-name" />
  </div>
  <div class="grid gap-6 sm:grid-cols-2">
    <TextField required type="email" name="email" label={t['contactForm.email']} placeholder={t['contactForm.email']} autocomplete="email" />
    <TextField type="tel" name="phone" label={t['contactForm.phone']} placeholder={t['contactForm.phone']} autocomplete="tel" />
  </div>

  <div class="flex flex-col">
    <label for="contact-topic" class="mb-1 font-label text-size-sm font-medium leading-body text-brand-primary">{t['contactForm.topic']}</label>
    <select
      id="contact-topic"
      name="topic"
      class="block h-[38px] w-full rounded-pill border border-brand-primary bg-transparent px-5 py-2 font-sans text-size-sm text-brand-primary"
      required
      data-topic-select
    >
      <option value="" selected={!defaultTopic} disabled>{t['contactForm.topicPlaceholder']}</option>
      {
        topics.map((t) => (
          <option value={t.value} selected={t.value === defaultTopic}>
            {t.label}
          </option>
        ))
      }
    </select>
  </div>

  <TextArea name="message" required label={t['contactForm.message']} rows={7} />

  <label class="flex items-center gap-2 font-label text-size-sm font-medium text-brand-primary">
    <input type="checkbox" required name="privacyConsent" data-privacy-checkbox />
    <span>{t['contactForm.consent']} <a href="/privacy-policy" class="text-link underline">{t['contactForm.consentLink']}</a></span>
  </label>

  <Button type="submit" variant="primary-inverse" class="w-full" data-submit disabled>{t['contactForm.submit']}</Button>
</form>

<script>
  import { localizeValidation } from '../lib/formValidation'

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    localizeValidation(form)
    const checkbox = form.querySelector<HTMLInputElement>('[data-privacy-checkbox]')
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')
    if (!checkbox || !submit) return

    const sync = () => {
      submit.disabled = !checkbox.checked
    }
    checkbox.addEventListener('change', sync)
    sync()

    form.addEventListener('submit', (e) => {
      if (!checkbox.checked) {
        e.preventDefault()
      }
    })
  })
</script>
