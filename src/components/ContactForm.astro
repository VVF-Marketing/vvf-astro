---
import Button from './Button.astro'
import TextField from './TextField.astro'
import TextArea from './TextArea.astro'
import { getGlobalCopy } from '../lib/globalCopy'

const t = await getGlobalCopy(Astro)

export interface Props {
  defaultTopic?: string
}

const { defaultTopic } = Astro.props as Props

// Topics and order as on the live contact form.
const topics = [
  { value: 'general', label: t['contactForm.topic.general'] },
  { value: 'donation-support', label: t['contactForm.topic.donation'] },
  { value: 'child-sponsorship', label: t['contactForm.topic.sponsorship'] },
  { value: 'media-press', label: t['contactForm.topic.media'] },
  { value: 'corporate-partnerships', label: t['contactForm.topic.corporate'] },
  { value: 'events', label: t['contactForm.topic.events'] },
  { value: 'volunteering', label: t['contactForm.topic.volunteering'] },
  { value: 'other', label: t['contactForm.topic.other'] },
]
---

<!-- Live counterpart: the contact page `.form` (Webflow form). -->
<form class="flex flex-col gap-6" data-contact-form novalidate>
  <div class="grid gap-6 sm:grid-cols-2">
    <TextField required name="firstName" label={t['contactForm.firstName']} placeholder={t['contactForm.firstName']} autocomplete="given-name" />
    <TextField required name="lastName" label={t['contactForm.lastName']} placeholder={t['contactForm.lastName']} autocomplete="family-name" />
  </div>
  <div class="grid gap-6 sm:grid-cols-2">
    <TextField required type="email" name="email" label={t['contactForm.email']} placeholder={t['contactForm.email']} autocomplete="email" />
    <TextField type="tel" name="phone" label={t['contactForm.phone']} placeholder={t['contactForm.phone']} autocomplete="tel" />
  </div>

  <div class="flex flex-col">
    <label for="contact-topic" class="mb-1 font-body text-size-sm font-medium leading-body text-brand-primary">{t['contactForm.topic']}</label>
    <select
      id="contact-topic"
      name="topic"
      class="block h-[38px] w-full rounded-pill border border-brand-primary bg-transparent px-5 py-2 font-sans text-size-sm text-brand-primary"
      data-topic-select
    >
      {
        topics.map((t) => (
          <option value={t.value} selected={t.value === defaultTopic}>
            {t.label}
          </option>
        ))
      }
    </select>
  </div>

  <TextArea name="message" required label={t['contactForm.message']} rows={7} />

  <label class="flex items-center gap-2 font-body text-size-sm font-medium text-brand-primary">
    <input type="checkbox" required name="privacyConsent" data-privacy-checkbox />
    <span>{t['contactForm.consent']} <a href="/privacy-policy" class="text-link underline">{t['contactForm.consentLink']}</a></span>
  </label>

  <Button type="submit" variant="primary-inverse" class="w-full" data-submit disabled>{t['contactForm.submit']}</Button>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const checkbox = form.querySelector<HTMLInputElement>('[data-privacy-checkbox]')
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')
    if (!checkbox || !submit) return

    const sync = () => {
      submit.disabled = !checkbox.checked
    }
    checkbox.addEventListener('change', sync)
    sync()

    form.addEventListener('submit', (e) => {
      if (!checkbox.checked) {
        e.preventDefault()
      }
    })
  })
</script>
