---
import Layout from './Layout.astro'
import Header from '../components/Header.astro'
import AnnouncementBanner from '../components/AnnouncementBanner.astro'
import Footer from '../components/Footer.astro'
import { getCampaignSettings } from '../lib/content'

export interface Props {
  title: string
  description?: string
  image?: string
  background?: 'page' | 'section'
}

const { title, description, image, background } = Astro.props as Props
const campaignSettings = await getCampaignSettings()
---

<Layout title={title} description={description} image={image} background={background}>
  <AnnouncementBanner active={campaignSettings.active} text={campaignSettings.bannerText} />
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</Layout>
