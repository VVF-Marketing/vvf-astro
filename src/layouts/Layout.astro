---
import '../index.css';
import pageSeo from '../data/page-seo.json';

interface Props {
  title: string;
  description?: string;
  // Share image (path or absolute URL); defaults to the live site's.
  image?: string;
  // Live event pages use a lighter body background (neutral-section).
  background?: 'page' | 'section';
}

// Static pages take their live title/description/share image from
// src/data/page-seo.json (generated by scripts/migrate); props win for CMS
// detail pages, which pass their own EmDash SEO fields.
const DEFAULT_IMAGE = '/images/og-default.jpg';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const live = (pageSeo as Record<string, { title?: string; description?: string; image?: string }>)[path] ?? {};
const props = Astro.props;
const title = live.title ?? props.title;
const description = live.description ?? props.description ?? 'Victoria Venezuela Foundation provides nutrition, medical care and education to children in Venezuela.';
const image = props.image ?? live.image ?? DEFAULT_IMAGE;
const background = props.background ?? 'page';
const site = Astro.site ?? Astro.url;
const canonical = new URL(path, site).href;
const imageUrl = new URL(image, site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="description" content={description}/>
    <link rel="canonical" href={canonical}/>
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="Victoria Venezuela Foundation"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonical}/>
    <meta property="og:image" content={imageUrl}/>
    <meta name="twitter:card" content="summary_large_image"/>
    <link rel="icon" type="image/png" href="/favicon.png"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Open+Sans:wght@400;600;700&family=Poppins:wght@500;600&display=swap" rel="stylesheet"/>
   </head>
  <body class={background === 'section' ? 'bg-neutral-section' : undefined}>
    <slot/>
   </body>
</html>
