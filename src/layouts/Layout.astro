---
import '../index.css';
import { LANG_TAGS, localeFromPath, stripLocale, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  // Share image (path or absolute URL); defaults to the live site's.
  image?: string;
  // Live event pages use a lighter body background (neutral-section).
  background?: 'page' | 'section';
  // This page's path in each locale it has its own content in. Defaults to
  // English only; a Spanish request for a page without Spanish content is
  // then canonicalized to the English URL and gets no hreflang alternates.
  alternates?: Partial<Record<Locale, string>>;
}

// Static pages pass their SEO from their copy slots (src/lib/copy.ts); CMS
// detail pages pass their own EmDash SEO fields.
const DEFAULT_IMAGE = '/images/og-default.jpg';
const locale = localeFromPath(Astro.originPathname);
// English path of this page (Spanish pages are rewritten from /es/...).
const path = stripLocale(Astro.originPathname.replace(/\/$/, '') || '/');
const props = Astro.props;
const title = props.title;
const description = props.description ?? 'Victoria Venezuela Foundation provides nutrition, medical care and education to children in Venezuela.';
const image = props.image ?? DEFAULT_IMAGE;
const background = props.background ?? 'page';
const site = Astro.site ?? Astro.url;
const alternates = props.alternates ?? { en: path };
const canonical = new URL(alternates[locale] ?? alternates.en ?? path, site).href;
const hreflangs =
  Object.keys(alternates).length > 1
    ? [
        ...(Object.entries(alternates) as [Locale, string][]).map(([l, p]) => ({ lang: LANG_TAGS[l], href: new URL(p, site).href })),
        ...(alternates.en ? [{ lang: 'x-default', href: new URL(alternates.en, site).href }] : []),
      ]
    : [];
const imageUrl = new URL(image, site).href;
---

<!DOCTYPE html>
<html lang={LANG_TAGS[locale]}>
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="description" content={description}/>
    <link rel="canonical" href={canonical}/>
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href}/>)}
    <meta property="og:locale" content={LANG_TAGS[locale].replace('-', '_')}/>
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="Victoria Venezuela Foundation"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonical}/>
    <meta property="og:image" content={imageUrl}/>
    <meta name="twitter:card" content="summary_large_image"/>
    <link rel="icon" type="image/png" href="/favicon.png"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Open+Sans:wght@400;600;700&family=Poppins:wght@500;600&display=swap" rel="stylesheet"/>
   </head>
  <body class={background === 'section' ? 'bg-neutral-section' : undefined}>
    <slot/>
   </body>
</html>
