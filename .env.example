# Local development needs none of these: `npm run dev` uses SQLite
# (./data.db) and media on disk (./uploads). Every value is read when the
# server starts, never baked into the build, so one container image runs in
# any environment (docs-site: "Running anywhere").

# --- Deployed mode (container image) -------------------------------------
# The image is built with DB_ADAPTER=postgres and STORAGE=s3; scripts/start.mjs
# refuses to start if a setting its mode needs is missing.
# DB_ADAPTER=postgres
# DATABASE_URL=postgres://user:password@host:5432/vvf
# DATABASE_SSL=true
# The direct (unpooled) connection, for migrations, `npm run db:setup` and
# `npm run data:import`; DATABASE_URL is used when it's unset. On Vercel with
# Neon, DATABASE_URL is the pooled URL and the integration sets this one.
# DATABASE_URL_UNPOOLED=postgres://user:password@host:5432/vvf
# Connections each server instance keeps (default 5; sessions use 2 more).
# DATABASE_POOL_MAX=5
# STORAGE=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=vvf-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PUBLIC_URL=
# The database `npm run db:setup` may migrate without asking: the fingerprint
# it prints for this environment's database (docs-site: "Running anywhere").
# EMDASH_TARGET_FINGERPRINT=

# --- Vercel (docs-site: "Deploying to Vercel") -----------------------------
# Build-time: DEPLOY_TARGET=vercel builds a Vercel deployment (Node.js
# functions) instead of the Node server; set it with DB_ADAPTER and STORAGE.
# DEPLOY_TARGET=vercel
# Runtime: the bearer secret Vercel Cron sends to /api/cron/emdash (scheduled
# publishing, plugin cron, cleanup). Required on Vercel, as is EMDASH_SYNC_PAT:
# without either, the site answers 503 rather than silently not publishing
# scheduled posts or not syncing pages.
# CRON_SECRET=
# Set by Vercel when "Protection Bypass for Automation" is on: lets the
# static-page sync reach its own protected preview deployment.
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Double the Donation public key (Corporate Sponsorships); defaults to the live key.
# DTD_PUBLIC_KEY=

# Form emails (Contact and Newsletter, spec 8.4) through Resend. Unset, the
# forms tell visitors to write to info@ instead. The sender's domain must be
# verified in Resend. FROM and TO default to the spec's values.
# FORM_MAIL_API_KEY=
# FORM_MAIL_FROM="Victoria Venezuela Foundation website <website@victoriavenezuelafoundation.org>"
# FORM_MAIL_TO=info@victoriavenezuelafoundation.org,enrique@paulainc.ca

# Google Tag Manager container, loaded in the head of every page (VVF's is
# GTM-W33SN672). Set it in production only: unset, no tags load, so local
# and preview visits stay out of analytics.
# GTM_CONTAINER_ID=GTM-W33SN672

# Webflow Data API (migration only: scripts/migrate). Site token with CMS: Read-only (no other scopes).
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=

# Service PAT used by the static-page sync (src/lib/staticPageSync.ts) to
# call EmDash's admin API. Generate one via the EmDash admin UI's token
# settings (name: static-page-sync, scopes: content:read, content:write) —
# do NOT use a devBypass-minted token in any deployed environment, it 403s
# outside `astro dev`.
EMDASH_SYNC_PAT=

# Admin token for `npm run cms:schema` and `npm run migrate:copy-collections`
# only (scopes: content:read, content:write, schema:read, schema:write); set
# it in your shell when running them, never in the running server's
# environment. EMDASH_URL is the server they talk to.
EMDASH_ADMIN_TOKEN=
EMDASH_URL=http://localhost:4321

# Comma-separated emails of the people who may create, change or publish
# child profiles (safeguarding sign-off). Everyone else below admin can only
# read published profiles. Never commit real addresses.
SAFEGUARDING_USERS=
