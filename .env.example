# EmDash needs no required env vars for local dev (SQLite + local disk
# storage, configured directly in astro.config.mjs). Add production
# database/storage credentials here once a deploy target is chosen.

# Webflow Data API (migration only: scripts/migrate). Site token with CMS: Read-only (no other scopes).
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=

# Service PAT used by the static-page sync (src/lib/emdash-page-sync.ts) to
# call EmDash's admin API. Generate one via the EmDash admin UI's token
# settings (name: static-page-sync, scopes: content:read, content:write) —
# do NOT use a devBypass-minted token in any deployed environment, it 403s
# outside `astro dev`.
EMDASH_SYNC_PAT=
