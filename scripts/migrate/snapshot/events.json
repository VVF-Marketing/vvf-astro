    "programHtml": "<ul><li><strong>8:00 AM</strong> Registration &amp; Breakfast</li><li><strong>9:30 AM</strong> Shotgun start</li><li><strong>Right after tournament</strong> Lunch, Auction and Awards Reception</li><li><strong>All day</strong> Open bar, on-course contests, photos</li></ul>",
    "includesHtml": "<ul><li>Complimentary breakfast</li><li>On-course beverages</li><li>18-hole green fee</li><li>Contests and prizes</li><li>Awards reception</li><li>Full lunch &amp; premium bar</li></ul>",
