        },
        {
          "type": "p",
          "text": "Three essential programs working together to support underprivileged children in Venezuela."
        },
        {
          "type": "icon",
          "src": "https://cdn.prod.website-files.com/698be8581713b564865abf49/6a09259f95b3e9f0007c99e1_15%20Nutrition.svg"
