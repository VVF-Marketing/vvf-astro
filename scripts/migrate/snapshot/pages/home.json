        {
          "type": "p",
          "text": "Medical"
        },
        {
          "type": "h4",
          "text": "Healthcare Access for Children"
        },
        {
          "type": "p",
          "text": "Our clinics provide checkups, treatment, and preventive care when access is scarce."
        },
        {
          "type": "icon",
          "src": "https://cdn.prod.website-files.com/698be8581713b564865abf49/6a09259f81004f19c5a27933_Vector.svg"
        },
        {
          "type": "p",
          "text": "Education"
        },
        {
          "type": "h4",
          "text": "Education Support for Children"
        },
        {
          "type": "p",
          "text": "We keep children in school with supplies, support, and safe learning spaces."
        }
      ]
