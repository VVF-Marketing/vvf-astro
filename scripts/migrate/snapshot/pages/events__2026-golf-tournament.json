      "blocks": [
        {
          "type": "h2",
          "text": "This Year's Tournament Supports Earthquake Relief"
        },
        {
          "type": "p",
          "text": "100% of the net proceeds from the 2026 tournament go to our earthquake relief work in Venezuela. They will help build our permanent support center in La Guaira. When it opens, it will give displaced children and their families shelter, meals and medical care."
        },
        {
          "type": "image",
          "src": "https://cdn.prod.website-files.com/698be8581713b564865abf49/6aaad3ad352e7191b53e8a5e_VVF_LaGuaira_Centre_Exterior_Web_v1.jpg",
          "alt": "Render of the planned VVF support centre in La Guaira, seen from the street."
        },
        {
          "type": "p",
          "text": "How the center in La Guaira will look. The center is not built yet. These images are AI-generated renders."
        },
        {
          "type": "p",
          "text": "Three steps to change"
        },
        {
          "type": "image",
          "src": "https://cdn.prod.website-files.com/698be8581713b564865abf49/6aaad3ade21d9557ab097e79_VVF_LaGuaira_Card_Shelter_Web_v1.jpg",
          "alt": "Families arriving at the courtyard of the planned VVF support centre."
        },
        {
          "type": "h3",
          "text": "Shelter"
        },
        {
          "type": "p",
          "text": "A safe place to stay for families whose homes were destroyed in the June 2026 earthquakes."
        },
        {
          "type": "image",
          "src": "https://cdn.prod.website-files.com/698be8581713b564865abf49/6aaad3ad6b006e0df99c91bf_VVF_LaGuaira_Card_MedicalCare_Web_v1.jpg",
          "alt": "A nurse examining a young girl while her mother sits beside her."
        },
        {
          "type": "h3",
          "text": "Medical care"
        },
        {
          "type": "p",
          "text": "Check-ups, medicine and treatment for children and their families at the center."
        },
        {
          "type": "image",
          "src": "https://cdn.prod.website-files.com/698be8581713b564865abf49/6aaad3bcba94a6d021995d46_VVF_LaGuaira_Card_Nutrition_Web_v1.jpg",
          "alt": "Children eating a hot meal together in the centre's dining room."
        },
        {
          "type": "h3",
          "text": "Nutrition"
        },
        {
          "type": "p",
          "text": "Daily meals for the children staying at the support center in La Guaira."
        },
        {
          "type": "cta",
          "text": "Learn More",
          "href": "/venezuela-earthquake-relief"
        }
      ]
    },
