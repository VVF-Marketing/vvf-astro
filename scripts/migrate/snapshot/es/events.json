    "programHtml": "<ul><li><strong>8:00 a. m.</strong> Registro y desayuno</li><li><strong>9:30 a. m.</strong> Salida simultánea (shotgun)</li><li><strong>Justo después del torneo</strong> Almuerzo, subasta y recepción de entrega de premios</li><li><strong>Todo el día</strong> Barra libre, concursos en el campo, fotos</li></ul>",
    "includesHtml": "<ul><li>Desayuno de cortesía</li><li>Bebidas en el campo</li><li>Green fee de 18 hoyos</li><li>Concursos y premios</li><li>Recepción de premiación</li><li>Almuerzo completo y barra premium</li></ul>",
