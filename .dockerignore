# Never in an image: secrets, local data, generated output, child data.
.env
.env.*
!.env.example
data.db*
uploads/
.emdash/
node_modules/
dist/
.astro/

# Child data and migration inputs (see .gitignore for why these stay local).
# The public seed/seed.json and the public seed/media/ folders are kept: the
# tools image's `npm run db:setup` seeds them (the runtime image copies only
# dist/). scripts/lib/public-seed.test.mjs checks the child lines stay here.
seed/seed.local.json
seed/media/children/
seed/media/emdash-media.local.json
scripts/migrate/snapshot/
scripts/migrate/.cache/

# Not needed to build or run the site.
.git/
.github/
.devcontainer/
.obsidian/
.claude/
.opencode/
.storybook/
docs-site/
openspec/
e2e/
test-results/
playwright-report/
blob-report/
storybook-static/
*.md
!README.md
